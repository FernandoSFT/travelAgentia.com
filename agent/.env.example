# Copiar este fichero como .env y rellenar con credenciales reales.
# El fichero .env NO se hace commit (está en .gitignore).
# Añadir tantos SITE{N}_ bloques como portales se necesiten.

# ---------------------------------------------------------
# Sitio 1
# ---------------------------------------------------------
SITE1_KEY=portal1
SITE1_BASE_URL=https://www.ejemplo-portal1.com
SITE1_LOGIN_URL=https://www.ejemplo-portal1.com/login
SITE1_USERNAME=tu_usuario
SITE1_PASSWORD=tu_password
SITE1_USERNAME_FIELD=username
SITE1_PASSWORD_FIELD=password

# ---------------------------------------------------------
# Sitio 2
# ---------------------------------------------------------
SITE2_KEY=portal2
SITE2_BASE_URL=https://www.ejemplo-portal2.com
SITE2_LOGIN_URL=https://www.ejemplo-portal2.com/acceso
SITE2_USERNAME=tu_email@ejemplo.com
SITE2_PASSWORD=tu_password2
SITE2_USERNAME_FIELD=email
SITE2_PASSWORD_FIELD=pass

# ---------------------------------------------------------
# Sitio 3 (añadir más bloques SITE3_, SITE4_... según necesidad)
# ---------------------------------------------------------
# SITE3_KEY=portal3
# SITE3_BASE_URL=https://otro.com
# SITE3_LOGIN_URL=https://otro.com/auth
# SITE3_USERNAME=usuario3
# SITE3_PASSWORD=password3
# SITE3_USERNAME_FIELD=user
# SITE3_PASSWORD_FIELD=password
