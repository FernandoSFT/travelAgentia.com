---
import Layout from '../layouts/Layout.astro';
import { getSecciones, getHitos } from '../lib/notion';
import { marked } from 'marked';

const secciones = await getSecciones();
const pageData = secciones.filter(s => s.Página === "Sobre mí");
const hero = pageData.find(s => s.Slug === "sobre-mi-hero" || s.Slug.includes("hero"));
const hitos = await getHitos();
---

<Layout title={hero?.Título || "Sobre mí | TravelAgentIA"}>
	<main class="min-h-screen pt-32 pb-20 bg-bg-dark relative">
		<div class="absolute inset-0 bg-noise pointer-events-none"></div>
		
		<div class="container-custom relative z-10">
			{hero && (
				<section class="mb-24 text-center max-w-3xl mx-auto">
					<span class="label-gold">
						{hero.Subtítulo || "TRAYECTORIA"}
					</span>
					<h1 class="text-4xl md:text-6xl mb-8 text-gradient font-playfair">{hero.Título}</h1>
					<div class="text-text-muted text-lg leading-relaxed" set:html={marked.parse(hero.Cuerpo || "")} />
				</section>
			)}

			{hitos.length > 0 && (
				<section class="mt-20">
					<h2 class="text-3xl font-playfair text-center mb-16 text-gold-primary">Hitos clave</h2>
					<div class="relative border-l border-bg-border max-w-2xl mx-auto">
						{hitos.map((hito) => (
							<div class="mb-12 ml-8 relative">
								<span class="absolute -left-12 flex items-center justify-center w-8 h-8 bg-bg-dark border border-gold-primary rounded-full text-xl z-10 shadow-[0_0_10px_rgba(201,168,76,0.3)]">
									{hito["Icono / Emoji"] || "✦"}
								</span>
								<div class="premium-card py-6">
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="text-xl font-bold text-white">{hito.Título}</h3>
                    <span class="text-gold-primary font-jetbrains text-sm">{hito.Año}</span>
                  </div>
								  {hito.Descripción && <p class="text-sm text-text-muted">{hito.Descripción}</p>}
                </div>
							</div>
						))}
					</div>
				</section>
			)}
		</div>
	</main>
</Layout>
