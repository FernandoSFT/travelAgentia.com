---
import Layout from '../layouts/Layout.astro';
import DynamicBackground from '../components/ui/DynamicBackground.astro';
import { Monitor, Check, Clock, Users, Zap, MessageSquare, ArrowRight } from 'lucide-react';
---

<Layout
  title="Consultoría IA para Agencias de Viajes | 150€/hora | TravelAgentIA"
  description="Consultoría de IA para agencias de viajes: te guío personalmente para que implantes IA en tu oficina. Formación a tus empleados incluida. 150€/hora por videoconferencia."
  ogImage="/images/og/og-consultoria.png"
>
  <main class="pt-32 pb-20">
    <!-- HERO -->
    <section class="relative pt-32 pb-24 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <DynamicBackground variant="hero" />
      </div>
      <div class="container-custom relative z-10">
        <div class="max-w-3xl">
          <span class="label-gold">CONSULTORÍA</span>
          <h1 class="text-5xl md:text-6xl mb-6 text-gradient font-playfair">
            Te guío para que<br />lo implantes tú mismo.
          </h1>
          <p class="text-xl text-text-muted mb-4">
            Te acompaño en el proceso. Tú haces el trabajo; yo aseguro que se haga bien.
          </p>
          <div class="flex items-center gap-3 text-gold-primary text-lg font-jetbrains">
            <Clock class="w-5 h-5" />
            <span>150€ / hora</span>
          </div>
        </div>
      </div>
    </section>

    <!-- QUÉ ES -->
    <section class="py-20">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
          <div>
            <h2 class="text-3xl font-playfair text-white mb-6">¿Qué es la consultoría?</h2>
            <p class="text-text-muted text-lg mb-6 leading-relaxed">
              No te entrego una solución acabada — <strong class="text-white">te guío para que la construyas tú</strong>.
              Reviso cómo trabajas, identifico dónde puedes aplicar IA, y te acompaño paso a paso en la implantación.
            </p>
            <p class="text-text-muted text-lg mb-6 leading-relaxed">
              Como sigo gestionando mi agencia cada día, conozco de primera mano las herramientas, los flujos y los 
              problemas reales del sector. Sin teoría hueca.
            </p>
            <p class="text-text-muted text-lg mb-8 leading-relaxed">
              <strong class="text-white">La formación a tus empleados es parte del proceso.</strong> 
              Si tu equipo necesita aprender a usar lo que implantamos, lo trabajamos juntos.
            </p>

            <a href="/reservar" class="btn-primary inline-flex items-center gap-2">
              PEDIR SESIÓN <ArrowRight class="w-4 h-4" />
            </a>
          </div>

          <div class="space-y-6">
            <h3 class="text-sm font-jetbrains text-gold-primary uppercase tracking-widest">Qué incluye la consultoría</h3>
            {[
              { icon: Users, title: 'Guiado personal', desc: 'Sesiones one-to-one donde reviso tu situación, detecto oportunidades y te doy un plan de acción concreto.' },
              { icon: Zap, title: 'Implantación en tu oficina', desc: 'No en abstracto — trabajo con tu entorno real, tus herramientas y tus procesos.' },
              { icon: Monitor, title: 'Formación a tu equipo', desc: 'Tus empleados aprenden a usar lo que implantamos. Tú luego les guías con mi método.' },
              { icon: MessageSquare, title: 'Sin dependencia', desc: 'Mi objetivo es que cada vez me necesites menos. Te doy las claves para que sigas solo.' },
            ].map(item => (
              <div class="premium-card flex gap-4 items-start">
                <item.icon class="w-6 h-6 text-gold-primary shrink-0 mt-1" />
                <div>
                  <h4 class="text-white font-playfair mb-1">{item.title}</h4>
                  <p class="text-sm text-text-muted">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section class="py-20 border-t border-bg-border">
      <div class="container-custom">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-playfair text-white mb-4">¿Cómo funciona?</h2>
          <p class="text-text-muted">Tres pasos. Sin sorpresas.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { n: '01', title: 'Diagnóstico inicial', desc: 'Sesión breve para entender cómo trabajas, qué herramientas tienes y dónde está el potencial de IA.' },
            { n: '02', title: 'Plan de implantación', desc: 'Te doy un roadmap concreto: qué hacer, en qué orden, con qué herramientas. Tú lo ejecutas con mi guía.' },
            { n: '03', title: 'Seguimiento y ajuste', desc: 'Revisamos avances, resolvemos dudas, formamos a tu equipo. Sesiones según tu ritmo.' },
          ].map(step => (
            <div class="premium-card text-center relative">
              <span class="absolute -top-4 left-1/2 -translate-x-1/2 text-5xl font-playfair text-gold-primary/10">{step.n}</span>
              <h3 class="text-xl text-white font-playfair mb-3 mt-4">{step.title}</h3>
              <p class="text-sm text-text-muted">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- DIFERENCIA CON FORMACIÓN -->
    <section class="py-20 border-t border-bg-border">
      <div class="container-custom">
        <div class="premium-card p-8 md:p-12">
          <h2 class="text-2xl font-playfair text-white mb-6">⚠️ ¿Consultoría o Formación?</h2>
          <p class="text-text-muted mb-6 leading-relaxed">
            <strong class="text-white">Consultoría = te guío para que implantes IA en tu agencia.</strong> 
            La formación a tus empleados es parte del proceso. Ideal cuando quieres que la IA quede integrada de 
            verdad en tu día a día — no en una sesión formativa genérica.
          </p>
          <p class="text-text-muted leading-relaxed">
            Si solo necesitas que tu equipo aprenda a usar herramientas de IA sin un proceso de implantación 
            personalizado, mira <a href="/formacion" class="text-gold-primary underline">Formación</a>: 
            sesiones formativas a 60€/hora con contenido adaptado a su puesto.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-20 border-t border-bg-border">
      <div class="container-custom text-center">
        <h2 class="text-3xl font-playfair text-white mb-6">¿Hablamos?</h2>
        <p class="text-text-muted mb-10 max-w-xl mx-auto">
          Sesión inicial gratuita. Sin compromiso. Vemos tu situación y te digo si la consultoría tiene sentido para ti.
        </p>
        <a href="/reservar" class="btn-primary px-12 py-4 text-lg">RESERVAR SESIÓN GRATUITA</a>
      </div>
    </section>
  </main>
</Layout>
