---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft, CheckCircle2, LockKeyhole, ShieldCheck } from 'lucide-react';

const products = {
  PROGRAM_ONLINE: {
    label: 'Programa completo online',
    detail: 'Curso 1 + Curso 2 · grabaciones y materiales',
    price: 424,
  },
  PROGRAM_PRESENTIAL: {
    label: 'Programa completo en directo por Google Meet',
    detail: '17 sesiones · acompañamiento de implantación',
    price: 484,
  },
  COURSE_1_ONLINE: {
    label: 'Curso 1 online',
    detail: 'Preparar ChatGPT · 7 sesiones grabadas',
    price: 182,
  },
  COURSE_1_PRESENTIAL: {
    label: 'Curso 1 en directo por Google Meet',
    detail: 'Preparar ChatGPT · 7 sesiones en directo',
    price: 242,
  },
  COURSE_2_ONLINE: {
    label: 'Curso 2 online',
    detail: 'Aplicar a tu agencia · 10 sesiones grabadas',
    price: 303,
  },
  COURSE_2_PRESENTIAL: {
    label: 'Curso 2 en directo por Google Meet',
    detail: 'Aplicar a tu agencia · 10 sesiones en directo',
    price: 363,
  },
} as const;

type ProductId = keyof typeof products;
const defaultProduct: ProductId = 'PROGRAM_PRESENTIAL';
const selectedProduct = (Astro.url.searchParams.get('product') || defaultProduct) as ProductId;
const product = products[selectedProduct] || products[defaultProduct];
const description = 'Formaliza tu solicitud para el curso ChatGPT Work para agencias de viajes. Precios finales con IVA del 21 % incluido.';
---

<Layout title="Confirma tu plaza · Curso ChatGPT Work" description={description}>
  <Fragment slot="head">
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
  </Fragment>

  <main class="min-h-screen bg-bg-dark pb-20 pt-28 sm:pt-36">
    <div class="container-custom">
      <a href="/curso-chatgpt-work-agencias-viajes#precios" class="mb-8 inline-flex items-center gap-2 text-sm text-text-muted transition hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-primary">
        <ArrowLeft className="h-4 w-4" aria-hidden="true" /> Volver a modalidades y precios
      </a>

      <div class="mb-10 max-w-3xl">
        <span class="label-gold">Confirmación de plaza</span>
        <h1 class="mt-3 text-4xl text-white sm:text-5xl">Prepara tu inscripción</h1>
        <p class="mt-5 text-lg text-text-muted">Completa los datos del pedido. El pago se realizará en Stripe cuando el proceso esté activado y validado.</p>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
        <form id="checkout-form" class="rounded-2xl border border-bg-border bg-bg-card p-6 shadow-2xl shadow-black/20 sm:p-8" novalidate>
          <div class="mb-8 rounded-xl border border-amber-300/25 bg-amber-300/5 p-4 text-sm text-amber-100/90" role="status">
            <strong>Vista previa de checkout.</strong> Stripe está preparado, pero el cobro real permanece desactivado hasta completar las pruebas de pedido, pago, factura, email, acceso y reembolso.
          </div>

          <fieldset>
            <legend class="font-playfair text-2xl font-bold text-white">1. Producto</legend>
            <label class="mt-4 block text-sm font-medium text-white" for="product">Modalidad</label>
            <select id="product" name="product" class="mt-2 min-h-12 w-full rounded-lg border border-bg-border bg-bg-dark px-4 text-white focus:border-gold-primary focus:outline-none focus:ring-2 focus:ring-gold-primary" required>
              {Object.entries(products).map(([id, item]) => (
                <option value={id} selected={id === selectedProduct}>{item.label} · {item.price} € IVA incluido</option>
              ))}
            </select>
            <p id="product-detail" class="mt-2 text-sm text-text-muted">{product.detail}</p>
          </fieldset>

          <fieldset class="mt-10">
            <legend class="font-playfair text-2xl font-bold text-white">2. Datos del comprador</legend>
            <div class="mt-5 grid gap-5 sm:grid-cols-2">
              <label class="block text-sm text-text-muted">Nombre y apellidos *<input name="fullName" autocomplete="name" required class="checkout-input" /></label>
              <label class="block text-sm text-text-muted">Correo electrónico *<input name="email" type="email" autocomplete="email" required class="checkout-input" /></label>
              <label class="block text-sm text-text-muted">Teléfono<input name="phone" type="tel" autocomplete="tel" class="checkout-input" /></label>
              <label class="block text-sm text-text-muted">NIF/NIE/CIF para factura *<input name="taxId" autocomplete="off" required class="checkout-input" /></label>
            </div>
          </fieldset>

          <fieldset class="mt-10">
            <legend class="font-playfair text-2xl font-bold text-white">3. Datos de facturación</legend>
            <div class="mt-5 grid gap-5 sm:grid-cols-2">
              <label class="block text-sm text-text-muted sm:col-span-2">Razón social o nombre fiscal (si es distinto)<input name="billingName" autocomplete="organization" class="checkout-input" /></label>
              <label class="block text-sm text-text-muted sm:col-span-2">Dirección fiscal *<input name="address" autocomplete="street-address" required class="checkout-input" /></label>
              <label class="block text-sm text-text-muted">Código postal *<input name="postalCode" autocomplete="postal-code" required class="checkout-input" /></label>
              <label class="block text-sm text-text-muted">Localidad y provincia *<input name="city" autocomplete="address-level2" required class="checkout-input" /></label>
              <label class="block text-sm text-text-muted sm:col-span-2">País *<input name="country" value="España" autocomplete="country-name" required class="checkout-input" /></label>
            </div>
            <p class="mt-3 text-xs text-text-muted">La factura se emitirá a nombre de Fernando Andrés Córdoba Mercado como proveedor del servicio, con IVA del 21 % y sin retención de IRPF.</p>
          </fieldset>

          <fieldset class="mt-10 space-y-4">
            <legend class="font-playfair text-2xl font-bold text-white">4. Confirmaciones</legend>
            <label class="flex items-start gap-3 text-sm text-text-muted"><input name="terms" type="checkbox" required class="mt-1 h-4 w-4 accent-gold-primary" /> <span>He leído y acepto las <a href="#condiciones" class="text-gold-light underline">condiciones de compra, cancelación y reembolso</a>. *</span></label>
            <label class="flex items-start gap-3 text-sm text-text-muted"><input name="privacy" type="checkbox" required class="mt-1 h-4 w-4 accent-gold-primary" /> <span>Acepto el tratamiento de mis datos para gestionar este pedido y la relación contractual, conforme a la <a href="/privacidad" class="text-gold-light underline">política de privacidad</a>. *</span></label>
            <label class="flex items-start gap-3 text-sm text-text-muted"><input name="startEarly" type="checkbox" class="mt-1 h-4 w-4 accent-gold-primary" /> <span>Solicito que el servicio pueda comenzar antes de que finalice el plazo de desistimiento, cuando sea técnicamente posible. Entiendo que, si el servicio se ejecuta completamente con mi consentimiento expreso, puede aplicarse la excepción legal correspondiente.</span></label>
          </fieldset>

          <button id="submit-button" type="submit" class="btn-primary mt-9 inline-flex min-h-14 w-full items-center justify-center gap-2 px-6 py-4 text-center font-semibold disabled:cursor-not-allowed disabled:opacity-60">
            Continuar con pago seguro
          </button>
          <p id="form-status" class="mt-4 min-h-6 text-center text-sm text-text-muted" role="status" aria-live="polite"></p>
        </form>

        <aside class="space-y-5 lg:sticky lg:top-28">
          <section class="rounded-2xl border border-gold-primary/40 bg-bg-card p-6 shadow-2xl shadow-black/20 sm:p-8" aria-labelledby="summary-title">
            <div class="flex items-center gap-3"><LockKeyhole className="h-6 w-6 text-gold-primary" aria-hidden="true" /><h2 id="summary-title" class="text-2xl text-white">Resumen del pedido</h2></div>
            <div class="mt-6 border-b border-bg-border pb-6"><p id="summary-name" class="font-semibold text-white">{product.label}</p><p id="summary-detail" class="mt-2 text-sm text-text-muted">{product.detail}</p></div>
            <dl class="mt-6 space-y-3 text-sm"><div class="flex justify-between gap-4 text-text-muted"><dt>Base imponible</dt><dd id="summary-net" class="text-white"></dd></div><div class="flex justify-between gap-4 text-text-muted"><dt>IVA 21 %</dt><dd id="summary-vat" class="text-white"></dd></div><div class="flex justify-between gap-4 border-t border-bg-border pt-4 text-lg font-bold text-white"><dt>Total</dt><dd id="summary-total"></dd></div></dl>
            <p class="mt-6 text-xs text-text-muted">Importe final con IVA incluido. No se realizará ningún cargo mientras Stripe permanezca desactivado.</p>
          </section>
          <section class="rounded-2xl border border-bg-border bg-bg-card p-6" aria-label="Seguridad y modalidad"><div class="flex gap-3"><ShieldCheck className="h-6 w-6 shrink-0 text-gold-primary" aria-hidden="true" /><p class="text-sm text-text-muted"><strong class="text-white">Google Meet y privacidad.</strong> El directo se impartirá por Google Meet. Las prácticas utilizan datos sintéticos y no se solicita información sensible de clientes.</p></div><div class="mt-4 flex gap-3"><CheckCircle2 className="h-6 w-6 shrink-0 text-gold-primary" aria-hidden="true" /><p class="text-sm text-text-muted"><strong class="text-white">Calendario.</strong> 17 sesiones lunes, miércoles y viernes desde el 5 de octubre de 2026, con cambios posibles por festivos comunicados por email.</p></div></section>
        </aside>
      </div>

      <section id="condiciones" class="mt-12 max-w-4xl rounded-2xl border border-bg-border bg-bg-card p-6 text-sm text-text-muted sm:p-8" aria-labelledby="conditions-title">
        <h2 id="conditions-title" class="text-2xl text-white">Condiciones resumidas</h2>
        <div class="mt-5 space-y-3"><p>El precio incluye IVA al 21 %. La contratación queda formalizada cuando el pago sea autorizado y el pedido sea confirmado.</p><p>Cuando proceda el derecho de desistimiento, se aplicará el plazo legal de 14 días naturales para consumidores. Si se solicita el inicio anticipado, se recabará el consentimiento expreso y se informará de sus efectos legales.</p><p>Las fechas se organizan en lunes, miércoles y viernes desde el 5 de octubre de 2026 y pueden ajustarse por festivos. Cualquier cambio se comunicará por el correo facilitado.</p><p>El detalle completo deberá publicarse junto con el aviso legal, privacidad, cookies, condiciones de contratación y procedimiento de reclamaciones antes de activar el cobro real.</p></div>
        <p class="mt-5 text-xs">Referencias: <a href="https://www.boe.es/buscar/act.php?id=BOE-A-2007-20555" target="_blank" rel="noreferrer" class="text-gold-light underline">TRLGDCU</a> y <a href="https://www.boe.es/buscar/act.php?id=BOE-A-2002-13758" target="_blank" rel="noreferrer" class="text-gold-light underline">LSSI-CE</a>.</p>
      </section>
    </div>
  </main>

  <style>
    .checkout-input { margin-top: 0.5rem; min-height: 3rem; width: 100%; border-radius: 0.5rem; border: 1px solid rgb(51 51 51); background: #0d0d0d; padding: 0.75rem 1rem; color: white; outline: none; }
    .checkout-input:focus { border-color: #c9a84c; box-shadow: 0 0 0 2px rgb(201 168 76 / 0.25); }
  </style>

  <script define:vars={{ products }}>
    const form = document.querySelector('#checkout-form');
    const productSelect = document.querySelector('#product');
    const summaryName = document.querySelector('#summary-name');
    const summaryDetail = document.querySelector('#summary-detail');
    const productDetail = document.querySelector('#product-detail');
    const summaryNet = document.querySelector('#summary-net');
    const summaryVat = document.querySelector('#summary-vat');
    const summaryTotal = document.querySelector('#summary-total');
    const status = document.querySelector('#form-status');
    const submitButton = document.querySelector('#submit-button');
    const euros = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });

    function updateSummary() {
      const item = products[productSelect.value];
      if (!item) return;
      const net = item.price / 1.21;
      const vat = item.price - net;
      summaryName.textContent = item.label;
      summaryDetail.textContent = item.detail;
      productDetail.textContent = item.detail;
      summaryNet.textContent = euros.format(net);
      summaryVat.textContent = euros.format(vat);
      summaryTotal.textContent = euros.format(item.price);
    }

    productSelect.addEventListener('change', updateSummary);
    updateSummary();

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        status.textContent = 'Revisa los campos obligatorios y las confirmaciones antes de continuar.';
        return;
      }
      submitButton.disabled = true;
      status.textContent = 'El checkout de Stripe está preparado, pero el cobro real permanece desactivado hasta completar la validación final. No se ha realizado ningún cargo.';
      window.setTimeout(() => { submitButton.disabled = false; }, 1200);
    });
  </script>
</Layout>
