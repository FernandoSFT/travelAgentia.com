---
import Layout from '../layouts/Layout.astro';
import { getCursos } from '../lib/notion';
import { GraduationCap, Clock, Euro, CheckCircle2, ArrowRight } from 'lucide-react';

const cursos = await getCursos();
---

<Layout title="Formación en IA para Agentes | TravelAgentIA">
  <main class="pt-32 pb-20">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span class="label-gold">ACADEMIA TRAVELAGENTIA</span>
        <h1 class="text-5xl md:text-6xl mb-6 text-gradient font-playfair">Formación Especializada</h1>
        <p class="text-lg text-text-muted">
          No solo implementamos IA, también te enseñamos a dominarla. Cursos diseñados desde la experiencia de un agente de viajes para otros agentes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {cursos.length > 0 ? cursos.map((curso) => (
          <div class="premium-card relative group flex flex-col h-full overflow-hidden">
            <!-- Badge de estado -->
            <div class="absolute top-6 right-6 z-20">
              <span class={`px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest border ${
                curso.Estado === 'Abierto' ? 'bg-green-500/10 text-green-400 border-green-500/20' : 'bg-gold-primary/10 text-gold-primary border-gold-primary/20'
              }`}>
                {curso.Estado || 'Próximamente'}
              </span>
            </div>

            <div class="flex flex-col h-full">
              <div class="mb-8">
                <div class="w-16 h-16 rounded-2xl bg-gold-primary/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                  <GraduationCap class="w-8 h-8 text-gold-primary" />
                </div>
                <h2 class="text-3xl text-white font-playfair mb-4 leading-tight">{curso.Nombre}</h2>
                <div class="text-text-muted text-sm leading-relaxed mb-8" set:html={curso.Resumen}></div>
              </div>

              <div class="grid grid-cols-2 gap-4 mb-10 pt-8 border-t border-white/5">
                <div class="flex items-center gap-3">
                  <Clock class="w-5 h-5 text-gold-primary" />
                  <div class="text-xs">
                    <span class="text-text-muted block uppercase tracking-tighter">Duración</span>
                    <span class="text-white font-bold">{curso.Horas} horas</span>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <Euro class="w-5 h-5 text-gold-primary" />
                  <div class="text-xs">
                    <span class="text-text-muted block uppercase tracking-tighter">Precio</span>
                    <span class="text-white font-bold">{curso["Precio (€)"] > 0 ? `${curso["Precio (€)"]}€` : 'Consultar'}</span>
                  </div>
                </div>
              </div>

              <div class="mt-auto">
                <a href={curso["URL inscripción"] || "/reservar"} class="btn-primary w-full text-center flex items-center justify-center gap-2">
                  {curso.Estado === 'Abierto' ? 'INSCRIBIRME AHORA' : 'MÁS INFORMACIÓN'} <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            </div>
          </div>
        )) : (
          <div class="col-span-full py-20 text-center glass">
            <p class="text-text-muted italic">Cargando catálogo formativo desde Notion...</p>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>
