---
import Layout from '../layouts/Layout.astro';
import ContactoForm from '../components/ContactoForm';
import { getSecciones } from '../lib/notion';

const secciones = await getSecciones();
const contactoData = secciones.find(s => s.Página === "Contacto" && s.Slug === "contacto-intro");
---

<Layout title="Contacto">
	<main class="min-h-screen pt-32 pb-20 bg-background relative">
		<div class="absolute inset-0 bg-[url('/noise.png')] opacity-5 pointer-events-none"></div>
		
		<div class="container mx-auto px-4 relative z-10 max-w-4xl">
			{contactoData ? (
				<div class="text-center mb-16">
					<h1 class="text-4xl md:text-5xl mb-6 text-gradient">{contactoData.Título}</h1>
					<p class="text-gray-300 text-lg">{contactoData.Cuerpo}</p>
				</div>
			) : (
				<div class="text-center mb-16">
					<h1 class="text-4xl md:text-5xl mb-6 text-gradient">Hablemos</h1>
					<p class="text-gray-300 text-lg">Déjame tus datos y me pondré en contacto contigo lo antes posible.</p>
				</div>
			)}
			
			<ContactoForm client:load />
		</div>
	</main>
</Layout>
