---
import Layout from '../../layouts/Layout.astro';
import DynamicBackground from '../../components/ui/DynamicBackground.astro';
import { getPodcasts } from '../../lib/notion';
import { Mic2, Play, Calendar } from 'lucide-react';

const podcasts = await getPodcasts();
---

<Layout title="Podcasts | IA para Agencias de Viajes | TravelAgentIA">
  <main class="pt-32 pb-20">
    <!-- HERO -->
    <section class="relative pb-20 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <DynamicBackground variant="hero" />
      </div>
      <div class="container-custom relative z-10">
        <div class="text-center max-w-3xl mx-auto">
          <span class="label-gold">CONTENIDO EN AUDIO</span>
          <h1 class="text-5xl md:text-6xl mb-6 text-gradient font-playfair">Podcasts & Charlas</h1>
          <p class="text-lg text-text-muted">
            Escucha nuestras reflexiones sobre la automatización y la IA aplicadas al sector travel. Episodios cortos, directos y llenos de valor.
          </p>
        </div>
      </div>
    </section>

    <!-- PODCASTS GRID -->
    <div class="container-custom">
        {podcasts.length > 0 ? podcasts.map((item) => (
          <div class="premium-card flex flex-col md:flex-row gap-8 items-center hover:border-gold-primary/30 transition-all">
            <div class="w-full md:w-48 aspect-square rounded-lg overflow-hidden border border-bg-border shrink-0 bg-bg-card relative group">
              {item.Portada?.[0]?.url ? (
                <img src={item.Portada[0].url} alt={item.Título} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gold-primary/5">
                  <Mic2 class="w-12 h-12 text-gold-primary/20" />
                </div>
              )}
              <div class="absolute inset-0 bg-bg-dark/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                <div class="w-12 h-12 rounded-full bg-gold-primary flex items-center justify-center text-bg-dark shadow-xl">
                  <Play class="w-6 h-6 fill-current" />
                </div>
              </div>
            </div>

            <div class="flex-grow">
              <div class="flex items-center gap-2 text-[10px] font-jetbrains text-gold-light uppercase tracking-widest mb-2">
                <Calendar class="w-3 h-3" />
                {item.Fecha?.start ? new Date(item.Fecha.start).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' }) : 'Reciente'}
              </div>
              <h2 class="text-2xl text-white font-playfair mb-3 leading-tight">{item.Título}</h2>
              <p class="text-sm text-text-muted mb-6 line-clamp-2">{item.Resumen}</p>
              
              <div class="flex flex-wrap gap-4">
                <a href={item.Enlace} target="_blank" class="btn-primary py-2 px-6 text-xs flex items-center gap-2">
                   ESCUCHAR AHORA <Play class="w-3 h-3 fill-current" />
                </a>
                {item.Plataforma && (
                  <span class="px-4 py-2 bg-white/5 rounded-full text-[10px] font-bold text-text-muted border border-white/10 uppercase tracking-tighter">
                    {item.Plataforma}
                  </span>
                )}
              </div>
            </div>
          </div>
        )) : (
          <div class="col-span-full py-20 text-center glass">
            <p class="text-gold-primary text-4xl mb-4">🎙️</p>
            <p class="text-white text-xl font-playfair mb-3">Próximamente</p>
            <p class="text-text-muted italic">Estamos preparando episodios con contenido exclusivo sobre IA en turismo.</p>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>
