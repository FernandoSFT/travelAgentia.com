---
import Layout from '../layouts/Layout.astro';
import { Users, GraduationCap, Handshake, Video, BookOpen, MessageCircle, Download, Check } from 'lucide-react';

const SKOOL_URL = 'https://www.skool.com/automatiza2-1075';
const UTM_HERO = '?utm_source=travelagentia&utm_medium=hero_cta&utm_campaign=comunidad';
const UTM_BOTTOM = '?utm_source=travelagentia&utm_medium=bottom_cta&utm_campaign=comunidad';
---

<Layout
  title="Comunidad de IA para Agentes de Viajes"
  description="Únete a +70 agentes de viajes que ya aplican IA en su día a día. Formación práctica, sesiones en vivo y networking profesional."
  ogImage="/images/og/og-comunidad.png"
>
  <main>
    <!-- HERO -->
    <section class="relative min-h-[80vh] flex items-center justify-center pt-32 pb-20">
      <div class="container-custom text-center">
        <span class="label-gold mb-4 inline-block">✦ +70 agentes ya dentro</span>
        <h1 class="text-4xl md:text-6xl mb-6 text-gradient max-w-4xl mx-auto">
          La comunidad de IA que habla tu idioma: el de agente de viajes
        </h1>
        <p class="text-lg md:text-xl text-text-muted mb-10 max-w-2xl mx-auto">
          Aprende, comparte y avanza con otros profesionales que ya aplican inteligencia artificial en su agencia. Sin tecnicismos. Sin humo. Solo soluciones que funcionan.
        </p>
        <a
          href={`${SKOOL_URL}${UTM_HERO}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary px-10 py-4 text-lg"
          data-analytics="click_comunidad_cta"
          data-location="hero"
        >
          Únete a la comunidad →
        </a>
      </div>
    </section>

    <!-- ¿QUÉ ES? -->
    <section class="section bg-bg-card">
      <div class="container-custom">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="premium-card text-center">
            <Users class="w-10 h-10 text-gold-primary mx-auto mb-4" />
            <h3 class="text-xl mb-2 text-white">Comunidad activa</h3>
            <p class="text-sm text-text-muted">Más de 70 agentes de viajes compartiendo casos reales, dudas del día a día y soluciones probadas. No estás solo.</p>
          </div>
          <div class="premium-card text-center">
            <GraduationCap class="w-10 h-10 text-gold-primary mx-auto mb-4" />
            <h3 class="text-xl mb-2 text-white">Formación práctica</h3>
            <p class="text-sm text-text-muted">Sesiones en vivo semanales, videoteca de tutoriales y biblioteca de prompts especializados para agencias.</p>
          </div>
          <div class="premium-card text-center">
            <Handshake class="w-10 h-10 text-gold-primary mx-auto mb-4" />
            <h3 class="text-xl mb-2 text-white">Networking profesional</h3>
            <p class="text-sm text-text-muted">Conecta con otros agentes que están en tu misma situación.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- QUÉ ENCONTRARÁS -->
    <section class="section bg-bg-dark">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="label-gold">DENTRO DE LA COMUNIDAD</span>
          <h2 class="text-4xl md:text-5xl mb-4 text-gold-primary">Qué encontrarás</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { icon: Video, title: 'Sesiones en vivo semanales', desc: 'Formación continua con casos reales' },
            { icon: BookOpen, title: 'Biblioteca de BecarIAs', desc: 'GPTs personalizados y prompts probados' },
            { icon: MessageCircle, title: 'Foro de la comunidad', desc: 'Pregunta, comparte y resuelve dudas' },
            { icon: Download, title: 'Recursos descargables', desc: 'Plantillas, checklists y guías prácticas' },
          ].map(item => (
            <div class="premium-card">
              <item.icon class="w-8 h-8 text-gold-primary mb-4" />
              <h3 class="text-lg mb-2 text-white">{item.title}</h3>
              <p class="text-sm text-text-muted">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TESTIMONIOS -->
    <section class="section bg-bg-card">
      <div class="container-custom text-center">
        <span class="label-gold">TESTIMONIOS</span>
        <h2 class="text-4xl md:text-5xl mb-12 text-gold-primary">Lo que dicen los agentes</h2>
        <p class="text-text-muted mb-8">Próximamente: testimonios filtrados desde Notion (Fuente = Comunidad o General)</p>
        <!-- Fallback estático mientras la DB no tiene datos etiquetados -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 opacity-60">
          {[1, 2, 3].map(i => (
            <div class="premium-card text-left">
              <p class="text-sm text-text-muted italic mb-4">"Testimonio de ejemplo. Se cargarán automáticamente desde Notion cuando se añadan entradas con Fuente = Comunidad."</p>
              <p class="text-xs text-gold-light font-bold">Agente de viajes</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="section bg-bg-dark">
      <div class="container-custom text-center">
        <h2 class="text-4xl md:text-5xl mb-6 text-gold-primary">¿Listo para dejar de improvisar con la IA?</h2>
        <a
          href={`${SKOOL_URL}${UTM_BOTTOM}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary px-10 py-4 text-lg mb-4 inline-block"
          data-analytics="click_comunidad_cta"
          data-location="bottom"
        >
          Únete a la comunidad →
        </a>
        <p class="text-sm text-gold-light mt-4">✦ Oferta de lanzamiento: precio especial para miembros fundadores.</p>
      </div>
    </section>
  </main>
</Layout>
