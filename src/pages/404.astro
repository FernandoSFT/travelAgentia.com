---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | TravelAgentIA">
  <main class="min-h-[80vh] flex items-center justify-center">
    <div class="container-custom text-center">
      <span class="label-gold">404</span>
      <h1 class="text-5xl md:text-7xl mb-6 text-gradient font-playfair">Página no encontrada</h1>
      <p class="text-lg text-text-muted mb-12 max-w-xl mx-auto">
        La página que buscas no existe o ha sido movida. Puede que el enlace esté roto o la dirección sea incorrecta.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">Volver al inicio</a>
        <a href="/contacto" class="btn-secondary">Contactar</a>
      </div>
    </div>
  </main>
</Layout>
