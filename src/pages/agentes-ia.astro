---
import Layout from '../layouts/Layout.astro';
import ContactFormAgentes from '../components/ContactFormAgentes';
import { MessageSquare, Search, FileText, Bell } from 'lucide-react';
---

<Layout
  title="Agentes de IA para Agencias de Viajes"
  description="Automatiza la atención al cliente, genera propuestas en minutos y no pierdas nunca más una venta por olvido. Agentes IA probados en agencias reales."
  ogImage="/images/og/og-agentes-ia.png"
>
  <main>
    <!-- HERO -->
    <section class="relative min-h-[80vh] flex items-center justify-center pt-32 pb-20">
      <div class="container-custom text-center">
        <span class="label-gold mb-4 inline-block">✦ Nuevo servicio</span>
        <h1 class="text-4xl md:text-6xl mb-6 text-gradient max-w-5xl mx-auto">
          Agentes de IA diseñados para tu agencia de viajes
        </h1>
        <p class="text-lg md:text-xl text-text-muted mb-10 max-w-2xl mx-auto">
          Automatiza la atención al cliente, genera propuestas en minutos y no pierdas nunca más una venta por olvido. Probado en una agencia real. Implementado en más de 70.
        </p>
        <div class="flex justify-center">
          <a
            href="#contacto-agentes"
            class="btn-primary px-10 py-4 text-lg"
            data-analytics="click_agentes_cta"
            data-location="hero"
          >
            Solicita información →
          </a>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section bg-bg-card">
      <div class="container-custom">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { icon: MessageSquare, title: 'Atención 24/7', desc: 'Responde dudas de clientes fuera de horario, incluso mientras duermes.' },
            { icon: Search, title: 'Búsqueda inteligente', desc: 'Encuenta destinos, hoteles y vuelos en segundos con contexto del cliente.' },
            { icon: FileText, title: 'Propuestas automáticas', desc: 'Genera itinerarios completos con presupuestos y fotos en minutos.' },
            { icon: Bell, title: 'Seguimiento comercial', desc: 'Revisa y redacta seguimientos automáticos cada lunes. 0 olvidos.' },
          ].map(f => (
            <div class="premium-card">
              <f.icon class="w-8 h-8 text-gold-primary mb-4" />
              <h3 class="text-lg mb-2 text-white">{f.title}</h3>
              <p class="text-sm text-text-muted">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CASOS DE USO -->
    <section class="section bg-bg-dark">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="label-gold">CASOS REALES</span>
          <h2 class="text-4xl md:text-5xl mb-4 text-gold-primary">Esto es lo que cambia en tu agencia</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { title: 'De email a expediente', before: '15-20 min', after: '30 seg', result: '95% ahorro' },
            { title: 'Propuesta completa', before: '2-3 horas', after: '20 min', result: 'Calidad premium' },
            { title: 'Seguimiento comercial', before: 'Olvidados', after: 'Auto cada lunes', result: '0 ventas perdidas' },
          ].map(c => (
            <div class="premium-card">
              <h3 class="text-xl mb-4 text-white">{c.title}</h3>
              <div class="space-y-3">
                <div class="flex justify-between text-sm">
                  <span class="text-text-muted">Antes</span>
                  <span class="text-red-400">{c.before}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-text-muted">Después</span>
                  <span class="text-green-400">{c.after}</span>
                </div>
                <div class="pt-3 border-t border-white/10">
                  <span class="text-xs text-gold-light uppercase tracking-widest">Resultado</span>
                  <p class="text-sm font-bold text-white mt-1">{c.result}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TESTIMONIOS -->
    <section class="section bg-bg-card">
      <div class="container-custom text-center">
        <span class="label-gold">TESTIMONIOS</span>
        <h2 class="text-4xl md:text-5xl mb-12 text-gold-primary">Agentes que ya lo usan</h2>
        <p class="text-text-muted mb-8">Próximamente: testimonios desde Notion filtrados por Fuente = Agentes IA o General</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 opacity-60">
          {[1, 2, 3].map(i => (
            <div class="premium-card text-left">
              <p class="text-sm text-text-muted italic mb-4">"Testimonio de ejemplo. Se cargarán automáticamente desde Notion."</p>
              <p class="text-xs text-gold-light font-bold">Agente de viajes</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA + FORMULARIO -->
    <section id="contacto-agentes" class="section bg-gradient-to-b from-bg-dark to-bg-card">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="label-gold">DA EL PRIMER PASO</span>
          <h2 class="text-4xl md:text-5xl mb-4 text-gold-primary">¿Quieres un agente IA trabajando para tu agencia?</h2>
          <p class="text-text-muted">Cuéntanos qué necesitas y te proponemos una solución a medida. Sin compromiso.</p>
        </div>
        <ContactFormAgentes client:visible />
      </div>
    </section>
  </main>
</Layout>
