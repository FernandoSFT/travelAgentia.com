---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reserva tu Consultoría IA | TravelAgentIA">
  <main class="pt-32 pb-20">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="label-gold">RESERVA DIRECTA</span>
        <h1 class="text-5xl md:text-6xl mb-6 text-gradient font-playfair">Agenda tu sesión de diagnóstico</h1>
        <p class="text-lg text-text-muted">
          Selecciona el día y la hora que mejor te vengan. La sesión se realizará por Google Meet y analizaremos cómo la IA puede optimizar tu agencia de viajes.
        </p>
      </div>

      <div class="glass p-4 md:p-8 rounded-2xl border-gold-primary/30 shadow-2xl relative overflow-hidden min-h-[700px]">
        <div class="absolute inset-0 bg-noise opacity-5 pointer-events-none"></div>
        
        <!-- Google Calendar Embed -->
        <iframe 
          src="https://calendar.app.google/e4XRYFbL3gk7ZeMP6" 
          style="border: 0" 
          width="100%" 
          height="700" 
          frameborder="0" 
          scrolling="no"
          class="rounded-xl bg-white/5"
        ></iframe>
      </div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="premium-card text-center">
          <div class="text-gold-primary text-2xl mb-4">60</div>
          <p class="text-sm font-jetbrains uppercase tracking-widest text-text-muted">Minutos de sesión</p>
        </div>
        <div class="premium-card text-center">
          <div class="text-gold-primary text-2xl mb-4">100%</div>
          <p class="text-sm font-jetbrains uppercase tracking-widest text-text-muted">Foco en tu agencia</p>
        </div>
        <div class="premium-card text-center">
          <div class="text-gold-primary text-2xl mb-4">Gratis</div>
          <p class="text-sm font-jetbrains uppercase tracking-widest text-text-muted">Sin compromiso</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
