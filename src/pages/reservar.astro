---
import Layout from '../layouts/Layout.astro';
import DynamicBackground from '../components/ui/DynamicBackground.astro';
import { Clock, Gift, ShieldCheck } from 'lucide-react';
---

<Layout title="Reserva tu Consultoría IA GRATUITA (60 min) | TravelAgentIA">
  <main class="pt-32 pb-20">
    <!-- HERO -->
    <section class="relative pb-16 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <DynamicBackground variant="hero" />
      </div>
      <div class="container-custom relative z-10">
        <div class="text-center max-w-4xl mx-auto">
          <span class="label-gold bg-gold-primary text-bg-dark px-4 py-1 rounded-full animate-pulse">OFERTA LIMITADA</span>
          <h1 class="text-5xl md:text-7xl mb-6 text-gradient font-playfair">Tu Primera Sesión de 60 min es GRATIS</h1>
          <p class="text-xl text-text-muted">
            Agenda ahora tu diagnóstico personalizado. Un profesional de agencia analizando tu negocio cara a cara. Sin coste, sin compromiso y con valor real desde el primer minuto.
          </p>
        </div>
      </div>
    </section>

    <!-- CONTENT -->
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
        <div class="premium-card flex items-center gap-6 border-gold-primary/30">
          <Clock class="w-12 h-12 text-gold-primary shrink-0" />
          <div>
            <h3 class="text-white font-bold">60 MINUTOS</h3>
            <p class="text-xs text-text-muted uppercase">Sesión Completa</p>
          </div>
        </div>
        <div class="premium-card flex items-center gap-6 border-gold-primary shadow-[0_0_20px_rgba(201,168,76,0.1)]">
          <Gift class="w-12 h-12 text-gold-primary shrink-0" />
          <div>
            <h3 class="text-white font-bold">100% GRATUITO</h3>
            <p class="text-xs text-text-muted uppercase">Sesión de Bienvenida</p>
          </div>
        </div>
        <div class="premium-card flex items-center gap-6 border-gold-primary/30">
          <ShieldCheck class="w-12 h-12 text-gold-primary shrink-0" />
          <div>
            <h3 class="text-white font-bold">VALOR REAL</h3>
            <p class="text-xs text-text-muted uppercase">Sin Humo</p>
          </div>
        </div>
      </div>

      <div class="glass p-4 md:p-8 rounded-2xl border-gold-primary/50 shadow-2xl relative overflow-hidden min-h-[700px]">
        <div class="absolute inset-0 bg-noise opacity-5 pointer-events-none"></div>

        <!-- Google Calendar Embed -->
        <iframe
          src="https://calendar.app.google/e4XRYFbL3gk7ZeMP6"
          style="border: 0"
          width="100%"
          height="800"
          frameborder="0"
          scrolling="no"
          class="rounded-xl bg-white/5"
        ></iframe>
      </div>
    </div>
  </main>
</Layout>
