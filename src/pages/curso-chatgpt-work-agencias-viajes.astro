---
import Layout from '../layouts/Layout.astro';
import CourseLeadForm from '../components/CourseLeadForm';
import {
  ArrowRight,
  Bot,
  BriefcaseBusiness,
  CalendarDays,
  Check,
  CheckCircle2,
  Clock3,
  GraduationCap,
  Laptop,
  LockKeyhole,
  MonitorPlay,
  ShieldCheck,
  Sparkles,
  Target,
  UserCheck,
  Users,
  X,
} from 'lucide-react';

const pageUrl = 'https://travelagentia.com/curso-chatgpt-work-agencias-viajes';
const description =
  'Curso ChatGPT Work para agencias de viajes: 17 sesiones prácticas en directo por Google Meet, planificadas lunes, miércoles y viernes desde el 5 de octubre de 2026, con casos sintéticos, seguridad y acompañamiento de implantación.';

const problems = [
  {
    icon: Bot,
    title: 'Sin método',
    description: 'Prompts sueltos que no se reutilizan ni se comparten en el equipo.',
  },
  {
    icon: Clock3,
    title: 'Sin ahorro real',
    description: 'Cada expediente vuelve a empezar de cero. La IA no devuelve horas.',
  },
  {
    icon: LockKeyhole,
    title: 'Sin seguridad',
    description: 'Datos de clientes y proveedores que entran en el chat sin control.',
  },
  {
    icon: UserCheck,
    title: 'Sin revisión humana',
    description: 'La IA propone, pero nadie garantiza que lo que sale sea correcto.',
  },
];

const courseOneTopics = [
  'Descarga, cuenta y configuración',
  'Aplicaciones conectadas',
  'Internet, navegador y Site',
  'Datos privados, permisos y seguridad',
  'Skills y comportamientos reutilizables',
  'Tareas programadas y monitorización',
  'Work y automatizaciones',
];

const courseTwoTopics = [
  'Captación y nueva solicitud',
  'Investigación y presupuesto',
  'Seguimiento comercial',
  'Reserva y confirmaciones',
  'Previaje y documentación',
  'Gestión de incidencias',
  'Postviaje y fidelización',
  'Proveedores, contratos y tarifas',
  'Administración, facturación y cobros',
  'Dirección, KPIs y mejora continua',
];

const faqItems = [
  {
    question: '¿Puedo hacer solo un curso?',
    answer:
      'Sí. Cada curso se puede solicitar por separado. El Curso 2 exige haber realizado el Curso 1 o superar una validación humana previa; no se cobra antes de validar. Con IVA del 21 % incluido: Curso 1 online, 182 €; Curso 1 en directo por Google Meet, 242 €; Curso 2 online, 303 €; y Curso 2 en directo por Google Meet, 363 €. El programa completo incluye ambos con descuento.',
  },
  {
    question: '¿Qué pasa si no puedo asistir en directo?',
    answer:
      'La edición online, disponible desde el 1 de noviembre, se prepara con grabaciones que muestran solo al instructor, las diapositivas y las demostraciones. La cámara, el micrófono, el nombre y el chat de participantes quedan excluidos por defecto. Las preguntas solo se reutilizan si el instructor las parafrasea y anonimiza o si existe un permiso explícito separado.',
  },
  {
    question: '¿Necesito conocimientos técnicos?',
    answer:
      'No. El nivel de entrada es inicial/intermedio y el Curso 1 prepara todo lo necesario. Para el Curso 2 se requiere completar el Curso 1 o superar la validación de entrada.',
  },
  {
    question: '¿La formación implanta sistemas en mi agencia?',
    answer:
      'No. El programa forma, no instala. Produce plantillas, checklists y mapas de proceso listos para revisión y decisión interna. Cualquier implantación posterior requiere un proyecto separado.',
  },
  {
    question: '¿Uso mis datos reales en las prácticas?',
    answer: 'No. Todas las prácticas usan datos 100 % sintéticos, por seguridad y privacidad.',
  },
];

const offers = [
  {
    '@type': 'Offer',
    name: 'Programa completo — Edición en directo por Google Meet',
    price: '484.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '484.00',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Programa completo — Edición online',
    price: '424.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '424.00',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Curso 1 — Preparar ChatGPT (online)',
    price: '181.50',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '181.50',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Curso 1 — Preparar ChatGPT (en directo por Google Meet)',
    price: '242.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '242.00',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Curso 2 — Aplicar a tu agencia (online)',
    price: '303.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '303.00',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Curso 2 — Aplicar a tu agencia (en directo por Google Meet)',
    price: '363.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '363.00',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Curso ChatGPT Work para agencias de viajes',
  description,
  url: pageUrl,
  provider: {
    '@type': 'Organization',
    name: 'TravelAgentIA',
    sameAs: 'https://travelagentia.com',
  },
  instructor: {
    '@type': 'Person',
    name: 'Fernando Córdoba',
    jobTitle: 'Agente de viajes y consultor de inteligencia artificial',
  },
  educationalLevel: 'Inicial e intermedio',
  timeRequired: 'PT34H',
  hasCourseInstance: [
    {
      '@type': 'CourseInstance',
      name: 'Edición en directo por Google Meet octubre–noviembre 2026',
      courseMode: 'Online en directo',
      startDate: '2026-10-05',
      endDate: '2026-11-11',
      description:
        '17 sesiones en directo por Google Meet, planificadas lunes, miércoles y viernes desde el 5 de octubre de 2026, de 17:00 a 19:00. Las fechas pueden cambiar por festivos y se confirman por correo operativo.',
    },
    {
      '@type': 'CourseInstance',
      name: 'Edición online desde el 1 de noviembre de 2026',
      courseMode: 'Online mediante grabaciones',
      startDate: '2026-11-01',
    },
  ],
  offers,
};

const offerSchema = {
  '@context': 'https://schema.org',
  ...offers[0],
  description:
    'Programa completo con 17 sesiones en directo y grabadas, preguntas en vivo y una hora de consultoría incluida.',
  priceSpecification: {
    '@type': 'UnitPriceSpecification',
    price: '484.00',
    priceCurrency: 'EUR',
    valueAddedTaxIncluded: true,
  },
  seller: {
    '@type': 'Organization',
    name: 'TravelAgentIA',
    url: 'https://travelagentia.com',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="Curso ChatGPT Work para agencias de viajes"
  description={description}
  ogImage="/images/og/og-formacion.png"
>
  <Fragment slot="head">
    <meta name="robots" content="index,follow" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(offerSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="overflow-x-clip bg-bg-dark">
    <!-- Hero -->
    <section class="relative flex min-h-[760px] items-center overflow-hidden pb-20 pt-32 sm:pt-36 lg:min-h-[820px]">
      <div class="absolute inset-0" aria-hidden="true">
        <img
          src="/images/hero.jpg"
          alt=""
          class="h-full w-full object-cover object-center motion-safe:animate-ken-burns"
          width="1920"
          height="1080"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-black/80"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-bg-dark via-bg-dark/90 to-bg-dark/55"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-bg-dark via-transparent to-black/30"></div>
      </div>

      <div class="container-custom relative z-10 w-full">
        <div class="max-w-4xl">
          <span class="label-gold">Programa en directo por Google Meet · Oct–Nov 2026</span>
          <h1 class="max-w-4xl text-4xl leading-[1.08] text-white sm:text-5xl md:text-6xl lg:text-7xl">
            Curso <span class="text-gradient">ChatGPT Work</span> para agencias de viajes
          </h1>
          <p class="mt-7 max-w-3xl text-lg text-text-muted sm:text-xl md:text-2xl">
            Convierte ChatGPT en una herramienta de trabajo segura y aplicable a tu agencia: 17 sesiones, dos cursos, casos 100 % sintéticos y acompañamiento de implantación.
          </p>
          <p class="mt-4 max-w-3xl text-base text-white/80 sm:text-lg">
            De agente a agente: quien te enseña ya lo usa cada día en su propia agencia.
          </p>

          <div class="mt-9 flex flex-col gap-4 sm:flex-row">
            <a
              href="#formulario"
              class="btn-primary inline-flex min-h-12 items-center justify-center gap-2 text-center focus:outline-none focus:ring-2 focus:ring-gold-light focus:ring-offset-2 focus:ring-offset-bg-dark"
            >
              Quiero información <ArrowRight className="h-5 w-5" aria-hidden="true" />
            </a>
            <a
              href="#precios"
              class="btn-secondary inline-flex min-h-12 items-center justify-center text-center focus:outline-none focus:ring-2 focus:ring-gold-light focus:ring-offset-2 focus:ring-offset-bg-dark"
            >
              Ver precios y modalidades
            </a>
          </div>
        </div>

        <div class="mt-12 grid max-w-5xl grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {[
          { icon: CalendarDays, title: 'Desde el 5 de octubre de 2026', text: 'Lunes · miércoles · viernes' },
            { icon: Clock3, title: 'Principalmente lun · mié · vie', text: '17:00–19:00 · fechas por confirmar' },
            { icon: Users, title: 'Preinscripción', text: 'Solicitud sujeta a confirmación' },
            { icon: ShieldCheck, title: 'Datos sintéticos', text: 'Privacidad desde el inicio' },
          ].map((item) => (
            <div class="rounded-xl border border-white/15 bg-black/45 p-4 backdrop-blur-sm">
              <item.icon className="mb-3 h-5 w-5 text-gold-primary" aria-hidden="true" />
              <p class="font-semibold text-white">{item.title}</p>
              <p class="mt-1 text-sm text-text-muted">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Problem -->
    <section class="section border-t border-bg-border" aria-labelledby="problema-title">
      <div class="container-custom">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <span class="label-gold">El problema</span>
          <h2 id="problema-title" class="text-3xl text-white sm:text-4xl md:text-5xl">
            Tu agencia usa ChatGPT a base de prueba y error
          </h2>
          <p class="mx-auto mt-6 text-lg text-text-muted">
            Cada agente inventa sus prompts desde cero, pierde tiempo y nadie garantiza que los datos de tus clientes estén protegidos. El reto no es probar la IA: es integrarla con procesos, seguridad y revisión humana.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {problems.map((problem) => (
            <article class="premium-card h-full p-6">
              <problem.icon className="mb-5 h-8 w-8 text-gold-primary" aria-hidden="true" />
              <h3 class="text-xl text-white">{problem.title}</h3>
              <p class="mt-3 text-sm text-text-muted">{problem.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Instructor -->
    <section class="section border-t border-bg-border bg-[#0D0D0D]" aria-labelledby="instructor-title">
      <div class="container-custom">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div class="relative mx-auto w-full max-w-md">
            <div class="absolute -inset-4 rounded-3xl bg-gold-primary/10 blur-2xl" aria-hidden="true"></div>
            <div class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-gold-primary/30 bg-bg-card">
              <img
                src="/images/fernando-elegante.jpg"
                alt="Fernando Córdoba, formador del curso ChatGPT Work para agencias de viajes"
                class="h-full w-full object-cover"
                width="800"
                height="1000"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-bg-dark/90 via-transparent to-transparent" aria-hidden="true"></div>
              <div class="absolute bottom-0 left-0 p-6">
                <p class="font-playfair text-2xl font-bold text-white">Fernando Córdoba</p>
                <p class="mt-1 text-sm text-gold-light">SAFE TOUR · TravelAgentIA</p>
              </div>
            </div>
          </div>

          <div>
            <span class="label-gold">De agente a agente</span>
            <h2 id="instructor-title" class="text-3xl text-white sm:text-4xl md:text-5xl">
              Te enseña quien ya lo vive cada día
            </h2>
            <p class="mt-6 text-lg text-text-muted">
              No te forma un consultor que nunca ha vendido un viaje, ni un técnico que solo ha visto la agencia desde fuera. Fernando es agente de viajes en activo y consultor de IA. Todo lo que aprenderás ya está funcionando en una agencia real.
            </p>

            <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
              {[
                { title: 'Agente desde 2008', text: '18 años en el sector, al frente de SAFE TOUR.' },
                { title: 'Consultor de IA', text: '3 años aplicando IA y automatización en agencias.' },
                { title: 'Formación universitaria', text: 'Curso Superior en IA Generativa, UCAM: 750 h y 30 ECTS.' },
                { title: 'Experiencia docente', text: '+15 ponencias y +200 agentes formados.' },
              ].map((item) => (
                <div class="rounded-xl border border-bg-border bg-bg-card p-5">
                  <CheckCircle2 className="mb-3 h-5 w-5 text-gold-primary" aria-hidden="true" />
                  <h3 class="text-base text-white">{item.title}</h3>
                  <p class="mt-2 text-sm text-text-muted">{item.text}</p>
                </div>
              ))}
            </div>

            <div class="mt-7 flex flex-wrap gap-2" aria-label="Organizaciones y eventos donde Fernando Córdoba ha participado">
              {['AEVAV', 'FITUR', 'Traveltool Summit', 'DIT Gestión', 'TravelAgentIA'].map((name) => (
                <span class="rounded-full border border-gold-primary/25 bg-gold-primary/5 px-3 py-2 font-jetbrains text-xs text-gold-light">
                  {name}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Courses -->
    <section class="section border-t border-bg-border" aria-labelledby="programa-title">
      <div class="container-custom">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <span class="label-gold">Qué vas a conseguir</span>
          <h2 id="programa-title" class="text-3xl text-white sm:text-4xl md:text-5xl">
            Dos cursos. Resultados claros.
          </h2>
          <p class="mx-auto mt-5 text-lg text-text-muted">
            Cada bloque tiene un objetivo concreto y un temario pensado para que salgas con algo usable en tu agencia.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <article class="premium-card flex h-full flex-col p-6 sm:p-8">
            <div class="mb-6 flex items-start justify-between gap-4">
              <div>
                <span class="font-jetbrains text-xs uppercase tracking-widest text-gold-primary">Curso 1 · 7 sesiones</span>
                <h3 class="mt-3 font-playfair text-2xl font-bold text-white sm:text-3xl">Preparar ChatGPT</h3>
              </div>
              <Laptop className="h-9 w-9 shrink-0 text-gold-primary" aria-hidden="true" />
            </div>
            <div class="mb-7 rounded-xl border border-gold-primary/25 bg-gold-primary/10 p-4">
              <p class="font-medium text-gold-light">Resultado: ChatGPT configurado como herramienta de trabajo segura para tu agencia.</p>
            </div>
            <ol class="space-y-3">
              {courseOneTopics.map((topic, index) => (
                <li class="flex items-start gap-3 text-text-muted">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gold-primary/10 font-jetbrains text-xs text-gold-light">
                    {index + 1}
                  </span>
                  <span class="pt-0.5">{topic}</span>
                </li>
              ))}
            </ol>
            <p class="mt-7 border-t border-bg-border pt-5 text-sm text-text-muted">
              El Curso 1 comienza el 5 de octubre de 2026.
            </p>
          </article>

          <article class="relative flex h-full flex-col rounded-xl border border-gold-primary bg-bg-card p-6 shadow-[0_0_40px_rgba(201,168,76,0.08)] sm:p-8">
            <span class="absolute right-4 top-0 -translate-y-1/2 rounded-full bg-gold-primary px-3 py-1 font-jetbrains text-[10px] font-bold uppercase tracking-wider text-bg-dark sm:right-6">
              El más interesante
            </span>
            <div class="mb-6 flex items-start justify-between gap-4">
              <div>
                <span class="font-jetbrains text-xs uppercase tracking-widest text-gold-primary">Curso 2 · 10 sesiones</span>
                <h3 class="mt-3 font-playfair text-2xl font-bold text-white sm:text-3xl">Aplicar a tu agencia</h3>
              </div>
              <BriefcaseBusiness className="h-9 w-9 shrink-0 text-gold-primary" aria-hidden="true" />
            </div>
            <div class="mb-7 rounded-xl border border-gold-primary/25 bg-gold-primary/10 p-4">
              <p class="font-medium text-gold-light">Resultado: aplicar la IA a los procesos estándar de tu agencia y empezar a ahorrar tiempo desde el primer día.</p>
            </div>
            <ol class="space-y-3">
              {courseTwoTopics.map((topic, index) => (
                <li class="flex items-start gap-3 text-text-muted">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gold-primary/10 font-jetbrains text-xs text-gold-light">
                    {index + 1}
                  </span>
                  <span class="pt-0.5">{topic}</span>
                </li>
              ))}
            </ol>
            <p class="mt-7 border-t border-bg-border pt-5 text-sm text-text-muted">
              El Curso 2 continúa después, con inicio previsto entre el 23 y el 26 de octubre de 2026. Se puede solicitar por separado, pero exige haber realizado el Curso 1 o superar una validación humana previa. No se cobra antes de validar.
            </p>
          </article>
        </div>

        <div class="mx-auto mt-8 max-w-4xl rounded-xl border border-gold-primary/25 bg-gold-primary/10 p-5 text-center text-sm text-gold-light">
          Son 17 sesiones dentro de la ventana del 5 de octubre al 11 de noviembre de 2026, con Curso 1 del 5 al 22 de octubre y Curso 2 a continuación (inicio estimado entre el 23 y el 26 de octubre). Las sesiones se planifican principalmente los lunes, miércoles y viernes. El calendario exacto está sujeto a confirmación escrita y cada sesión se confirma previamente por email operativo, no promocional.
        </div>

        <div class="mx-auto mt-8 max-w-4xl rounded-xl border border-white/10 bg-white/5 p-5 text-center text-sm text-text-muted">
          <Sparkles className="mx-auto mb-3 h-5 w-5 text-gold-primary" aria-hidden="true" />
          Los prompts, skills y flujos exactos se trabajan en las sesiones. Aquí ves el mapa; el método completo forma parte del programa.
        </div>
      </div>
    </section>

    <!-- Video -->
    <section class="section border-t border-bg-border bg-[#0D0D0D]" aria-labelledby="video-title">
      <div class="container-custom">
        <div class="mx-auto mb-10 max-w-3xl text-center">
          <span class="label-gold">Conoce el programa</span>
          <h2 id="video-title" class="text-3xl text-white sm:text-4xl md:text-5xl">Así funciona el curso</h2>
          <p class="mx-auto mt-5 text-lg text-text-muted">
            Descubre el enfoque práctico de la formación y cómo llevar ChatGPT a los procesos de tu agencia de viajes.
          </p>
        </div>

        <div class="mx-auto max-w-5xl">
          <div class="relative aspect-video overflow-hidden rounded-2xl border border-gold-primary/30 bg-black shadow-2xl shadow-black/30">
            <iframe
              src="https://www.youtube.com/embed/MrodwKBmAi8?rel=0&origin=https%3A%2F%2Ftravelagentia.com"
              title="Vídeo de presentación del curso ChatGPT Work para agencias de viajes"
              class="absolute inset-0 h-full w-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
          <p class="mt-4 text-center text-sm text-text-muted">
            ¿No se carga el reproductor? <a href="https://youtu.be/MrodwKBmAi8" class="text-gold-light underline decoration-gold-primary/60 underline-offset-4 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-primary">Ver el vídeo directamente en YouTube</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="precios" class="section scroll-mt-24 border-t border-bg-border bg-[#0D0D0D]" aria-labelledby="precios-title">
      <div class="container-custom">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <span class="label-gold">Precios y ediciones</span>
          <h2 id="precios-title" class="text-3xl text-white sm:text-4xl md:text-5xl">Elige cómo quieres aprender</h2>
          <p class="mx-auto mt-5 text-lg text-text-muted">
            Todos los importes incluyen el IVA vigente del 21 %. Los seis precios finales indicados son firmes.
