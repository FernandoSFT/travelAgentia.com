---
import Layout from '../layouts/Layout.astro';
import CourseLeadForm from '../components/CourseLeadForm';
import {
  ArrowRight,
  Bot,
  BriefcaseBusiness,
  CalendarDays,
  Check,
  CheckCircle2,
  Clock3,
  GraduationCap,
  Laptop,
  LockKeyhole,
  MonitorPlay,
  ShieldCheck,
  Sparkles,
  Target,
  UserCheck,
  Users,
  X,
} from 'lucide-react';

const pageUrl = 'https://travelagentia.com/curso-chatgpt-work-agencias-viajes';
const description =
  'Aprende con Fernando Córdoba, agente de viajes en activo y consultor de IA, el sistema que usa en SAFE TOUR. 17 sesiones, dos cursos y prácticas con datos ficticios.';

const problems = [
  {
    icon: Bot,
    title: 'Sin método',
    description: 'Prompts sueltos que no se reutilizan ni se comparten en el equipo.',
  },
  {
    icon: Clock3,
    title: 'Sin ahorro real',
    description: 'Cada expediente vuelve a empezar de cero. La IA no devuelve horas.',
  },
  {
    icon: LockKeyhole,
    title: 'Sin seguridad',
    description: 'Datos de clientes y proveedores que entran en el chat sin control.',
  },
  {
    icon: UserCheck,
    title: 'Sin revisión humana',
    description: 'La IA propone, pero nadie garantiza que lo que sale sea correcto.',
  },
];

const courseOneTopics = [
  'Descarga, cuenta y configuración',
  'Aplicaciones conectadas',
  'Internet, navegador y Site',
  'Datos privados, permisos y seguridad',
  'Skills y comportamientos reutilizables',
  'Tareas programadas y monitorización',
  'Work y automatizaciones',
];

const courseTwoTopics = [
  'Captación y nueva solicitud',
  'Investigación y presupuesto',
  'Seguimiento comercial',
  'Reserva y confirmaciones',
  'Previaje y documentación',
  'Gestión de incidencias',
  'Postviaje y fidelización',
  'Proveedores, contratos y tarifas',
  'Administración, facturación y cobros',
  'Dirección, KPIs y mejora continua',
];

const faqItems = [
  {
    question: '¿Puedo hacer solo un curso?',
    answer:
      'Sí. Cada curso se puede solicitar por separado. El Curso 2 exige haber realizado el Curso 1 o superar una validación humana previa; no se cobra antes de validar. Con IVA del 21 % incluido: Curso 1 online, 182 €; Curso 1 en directo por Google Meet, 242 €; Curso 2 online, 303 €; y Curso 2 en directo por Google Meet, 363 €. El programa completo incluye ambos con descuento.',
  },
  {
    question: '¿Qué pasa si no puedo asistir en directo?',
    answer:
      'La edición online se prepara con grabaciones que muestran solo al instructor, las diapositivas y las demostraciones. La cámara, el micrófono, el nombre y el chat de participantes quedan excluidos por defecto. Las preguntas solo se reutilizan si el instructor las parafrasea y anonimiza o si existe un permiso explícito separado.',
  },
  {
    question: '¿Necesito conocimientos técnicos?',
    answer:
      'No. El nivel de entrada es inicial/intermedio y el Curso 1 prepara todo lo necesario. Para el Curso 2 se requiere completar el Curso 1 o superar la validación de entrada.',
  },
  {
    question: '¿La formación implanta sistemas en mi agencia?',
    answer:
      'No. El programa forma, no instala. Produce plantillas, checklists y mapas de proceso listos para revisión y decisión interna. Cualquier implantación posterior requiere un proyecto separado.',
  },
  {
    question: '¿Uso mis datos reales en las prácticas?',
    answer: 'No. Todas las prácticas usan datos 100 % sintéticos, por seguridad y privacidad.',
  },
];

const offers = [
  {
    '@type': 'Offer',
    name: 'Programa completo — Edición en directo por Google Meet',
    price: '484.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '484.00',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Programa completo — Edición online',
    price: '423.50',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '423.50',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Curso 1 — Preparar ChatGPT (online)',
    price: '181.50',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '181.50',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Curso 1 — Preparar ChatGPT (en directo por Google Meet)',
    price: '242.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '242.00',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Curso 2 — Aplicar a tu agencia (online)',
    price: '302.50',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '302.50',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
  {
    '@type': 'Offer',
    name: 'Curso 2 — Aplicar a tu agencia (en directo por Google Meet)',
    price: '363.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: `${pageUrl}#formulario`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '363.00',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
  },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Curso ChatGPT Work para agencias de viajes',
  description,
  url: pageUrl,
  provider: {
    '@type': 'Organization',
    name: 'TravelAgentIA',
    sameAs: 'https://travelagentia.com',
  },
  instructor: {
    '@type': 'Person',
    name: 'Fernando Córdoba',
    jobTitle: 'Agente de viajes y consultor de inteligencia artificial',
  },
  educationalLevel: 'Inicial e intermedio',
  timeRequired: 'PT34H',
  hasCourseInstance: [{ '@type': 'CourseInstance', courseMode: 'Online en directo por Google Meet', description: 'Todos los miércoles y viernes. Cada sesión dura dos horas.' }, { '@type': 'CourseInstance', courseMode: 'Online mediante grabaciones' }],
  offers,
};

const offerSchema = {
  '@context': 'https://schema.org',
  ...offers[0],
  description:
    'Programa completo con 17 sesiones en directo y grabadas, preguntas en vivo y una hora de consultoría incluida.',
  priceSpecification: {
    '@type': 'UnitPriceSpecification',
    price: '484.00',
    priceCurrency: 'EUR',
    valueAddedTaxIncluded: true,
  },
  seller: {
    '@type': 'Organization',
    name: 'TravelAgentIA',
    url: 'https://travelagentia.com',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout title="Curso ChatGPT Work para agencias de viajes" description={description} ogImage="/images/og/og-formacion.png">
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(offerSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <main class="overflow-x-clip bg-bg-dark">
    <section class="relative overflow-hidden pb-16 pt-32 lg:pb-24 lg:pt-44">
      <img src="/images/hero.jpg" alt="" width="1920" height="1080" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-r from-bg-dark via-bg-dark/90 to-bg-dark/20"></div>
      <div class="container-custom relative grid items-center gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <span class="label-gold">Curso ChatGPT Work para agencias de viajes</span>
          <h1 class="text-4xl leading-[1.08] text-white sm:text-5xl lg:text-6xl xl:text-7xl">Aprende el sistema de <span class="text-gradient">IA</span> que uso en <span class="text-gold-light italic">mi propia agencia.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/80">Soy Fernando Córdoba, consultor de IA y agente de viajes en activo al frente de SAFE TOUR. Te enseño el sistema con el que trabajo hoy, adaptado al día a día de una agencia.</p>
          <div class="mt-8 flex flex-wrap gap-4"><a class="btn-primary" href="#programa">Ver el programa →</a><a class="btn-secondary" href="#formulario">Solicitar información</a></div><a href="#video-curso" class="mt-5 inline-flex items-center gap-2 text-gold-light underline underline-offset-4"><MonitorPlay className="h-5 w-5" aria-hidden="true" /> Ver el vídeo: así son las sesiones</a>
          <p class="mt-6 text-sm tracking-wide text-gold-light">De agente a agente.</p><p class="mt-3 text-base font-semibold text-white">Todos los miércoles y viernes · 2 horas por sesión</p>
        </div>
        <div class="relative mx-auto w-full max-w-lg" aria-label="Las tres piezas del sistema: IA, cerebro y CRM">
          <div class="mb-5 flex justify-between gap-3">
            <div class="rounded-xl border border-gold-primary/50 bg-bg-dark/90 p-4 shadow-xl"><Bot className="mb-2 h-7 w-7 text-gold-primary" /><p class="font-semibold text-white">Tu asistente de IA</p><p class="mt-1 text-xs text-text-muted">Consulta · Redacta · Ayuda</p></div>
            <div class="rounded-xl border border-gold-primary/50 bg-bg-dark/90 p-4 shadow-xl"><GraduationCap className="mb-2 h-7 w-7 text-gold-primary" /><p class="font-semibold text-white">Tu cerebro</p><p class="mt-1 text-xs text-text-muted">Procesos · Conocimiento</p></div>
          </div>
          <div class="rounded-t-2xl border border-gold-primary/40 bg-bg-dark p-3 shadow-2xl sm:p-5">
            <div class="mb-3 flex justify-between border-b border-bg-border pb-3"><span class="font-playfair text-gold-light">TravelAgentIA</span><span class="text-xs text-text-muted">Mi agencia · Ejemplo ficticio</span></div>
            <img src="/images/hero.jpg" alt="Destino turístico ilustrativo en el panel de trabajo" width="1920" height="1080" class="h-36 w-full rounded-lg object-cover sm:h-44" />
            <div class="mt-4 grid grid-cols-3 gap-2 text-center text-xs">{['Peticiones','Expedientes','Seguimientos'].map(t=><div class="rounded-lg border border-bg-border bg-bg-card py-3 text-white">{t}</div>)}</div>
          </div>
          <div class="mx-auto h-3 w-[108%] max-w-full rounded-b-xl bg-gradient-to-r from-bg-border via-text-muted to-bg-border"></div>
          <div class="ml-auto mt-5 flex max-w-xs items-center gap-3 rounded-xl border border-gold-primary/50 bg-bg-dark/90 p-4"><BriefcaseBusiness className="h-8 w-8 shrink-0 text-gold-primary" /><div><p class="font-semibold text-white">Tu CRM</p><p class="text-xs text-text-muted">Contactos · Servicios · Expedientes · Tareas</p></div></div>
        </div>
      </div>
    </section>
    <div class="border-y border-bg-border bg-bg-card/50"><div class="container-custom grid grid-cols-2 gap-5 py-6 lg:grid-cols-5">{[{icon:CalendarDays,text:'17 sesiones'},{icon:CalendarDays,text:'Miércoles y viernes'},{icon:Clock3,text:'2 horas por sesión'},{icon:Users,text:'En directo · Google Meet'},{icon:GraduationCap,text:'Campus Moodle'}].map(i=><div class="flex items-center gap-3 text-sm text-white"><i.icon className="h-6 w-6 shrink-0 text-gold-primary" />{i.text}</div>)}</div></div>
    <section class="border-b border-bg-border" aria-labelledby="instructor-title">
      <div class="container-custom grid gap-8 py-12 lg:grid-cols-[1.4fr_1fr] lg:items-center lg:py-16">
        <div><span class="label-gold">Tu profesor · Fernando Córdoba</span><h2 id="instructor-title" class="text-3xl text-white sm:text-4xl lg:text-5xl">Tu profesor también está al frente de una agencia.</h2><p class="mt-5 max-w-2xl text-lg text-text-muted">Una formación especializada, nacida del trabajo diario en SAFE TOUR. Conozco las peticiones, los proveedores, los expedientes y las incidencias porque también forman parte de mi día a día.</p><div class="mt-8 grid gap-4 sm:grid-cols-3">{[{icon:BriefcaseBusiness,text:'Agente de viajes en activo'},{icon:UserCheck,text:'Mi propia agencia: SAFE TOUR'},{icon:Bot,text:'Consultor de IA para agencias'}].map(i=><div class="border-l border-gold-primary/40 pl-4"><i.icon className="mb-3 h-7 w-7 text-gold-primary" /><p class="text-sm text-white">{i.text}</p></div>)}</div></div>
        <figure class="relative mx-auto w-full max-w-sm overflow-hidden rounded-2xl border border-gold-primary/30"><img src="/images/fernando-elegante.jpg" alt="Fernando Córdoba, agente de viajes y consultor de IA" width="800" height="1000" loading="lazy" class="h-[360px] w-full object-cover object-[center_25%] sm:h-[420px]" /><figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black p-5 pt-16 text-white"><p class="font-playfair text-xl">Fernando Córdoba</p><p class="text-sm text-gold-light">SAFE TOUR · TravelAgentIA</p></figcaption></figure>
      </div>
    </section>

    <section id="video-curso" class="section scroll-mt-24 border-y border-gold-primary/30 bg-bg-card/40" aria-labelledby="video-curso-title">
      <div class="container-custom">
        <div class="mb-8 max-w-3xl"><span class="label-gold">Conoce el curso por dentro</span>
          <h2 id="video-curso-title" class="text-3xl text-white sm:text-4xl lg:text-5xl">Así son las sesiones. Te lo explico en vídeo.</h2>
          <p class="mt-5 text-lg text-text-muted">Descubre cómo vamos a trabajar y qué vas a aprender para llevar la IA al día a día de tu agencia.</p>
          <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3 font-semibold text-gold-light"><span>Todos los miércoles y viernes</span><span>2 horas por sesión</span><span>En directo por Google Meet</span></p>
        </div>
        <div class="relative aspect-video overflow-hidden rounded-2xl border border-gold-primary/40 bg-black shadow-xl">
          <iframe src="https://www.youtube.com/embed/MrodwKBmAi8?rel=0" title="Fernando explica el curso y cómo funcionan las sesiones" class="absolute inset-0 h-full w-full" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <p class="mt-4 text-sm text-text-muted">Si el vídeo no se carga, <a href="https://youtu.be/MrodwKBmAi8" target="_blank" rel="noopener noreferrer" class="text-gold-light underline underline-offset-4">ábrelo directamente en YouTube →</a>.</p>
      </div>
    </section>
    <section class="section" aria-labelledby="sistema-title"><div class="container-custom"><span class="label-gold">Tres piezas</span><h2 id="sistema-title" class="text-3xl text-white sm:text-4xl lg:text-5xl">El sistema que uso. El sistema que aprenderás.</h2><p class="mt-4 text-text-muted">Entiende cómo se relacionan las herramientas, el conocimiento de tu agencia y los datos de trabajo. Tú diriges, revisas y decides.</p>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        <article class="premium-card p-6"><p class="text-xs uppercase tracking-widest text-gold-primary">01 · Tu herramienta de IA</p><h3 class="mt-3 font-playfair text-2xl text-white">Tu asistente de trabajo</h3><p class="mt-3 text-sm text-text-muted">ChatGPT configurado para trabajar con instrucciones y contexto de agencia.</p><div class="mt-6 space-y-4 rounded-xl border border-bg-border bg-bg-dark p-4 text-sm"><p class="rounded-lg bg-bg-card p-3 text-white">Prepara una propuesta de viaje de 7 días por Sicilia para una pareja.</p><div class="flex gap-3"><Bot className="h-6 w-6 shrink-0 text-gold-primary" /><p class="text-text-muted">Organizamos la petición, revisamos la información y preparamos un borrador.</p></div><p class="border-t border-bg-border pt-3 text-xs text-gold-light">Ejemplo ficticio · Resultado sujeto a revisión</p></div></article>
        <article class="premium-card p-6"><p class="text-xs uppercase tracking-widest text-gold-primary">02 · Tu cerebro</p><h3 class="mt-3 font-playfair text-2xl text-white">El conocimiento de tu agencia</h3><p class="mt-3 text-sm text-text-muted">Instrucciones, procesos y materiales organizados para reutilizarlos.</p><div class="mt-6 rounded-xl border border-bg-border bg-bg-dark p-4"><p class="mb-3 text-sm text-white">Mi cerebro en Drive</p>{['01 · Instrucciones','02 · Procesos','03 · Plantillas','04 · Conocimiento de la agencia','05 · Skills y recursos'].map(t=><div class="flex items-center gap-3 border-t border-bg-border py-3 text-sm text-text-muted"><span aria-hidden="true" class="h-3 w-4 rounded-sm bg-gold-primary/70"></span>{t}</div>)}</div></article>
        <article class="premium-card p-6"><p class="text-xs uppercase tracking-widest text-gold-primary">03 · Tu CRM</p><h3 class="mt-3 font-playfair text-2xl text-white">Tus datos, relacionados</h3><p class="mt-3 text-sm text-text-muted">Contactos, servicios, expedientes y tareas para seguir cada viaje.</p><div class="mt-6 overflow-x-auto rounded-xl border border-bg-border bg-bg-dark p-4"><p class="mb-3 text-sm text-gold-light">Expedientes · Datos ficticios</p><table class="w-full text-left text-xs"><thead class="text-text-muted"><tr><th class="py-3">Cliente</th><th>Destino</th><th>Estado</th></tr></thead><tbody>{[['Ana García','Japón','Planificación'],['Carlos Ruiz','Islandia','En viaje'],['Marta López','Costa Rica','Propuesta']].map(r=><tr class="border-t border-bg-border text-white"><td class="py-4 pr-2">{r[0]}</td><td class="pr-2">{r[1]}</td><td class="text-gold-light">{r[2]}</td></tr>)}</tbody></table><p class="mt-3 border-t border-bg-border pt-3 text-xs text-text-muted">Cada expediente conecta sus servicios y tareas.</p></div></article>
      </div></div></section>
    <section id="programa" class="section scroll-mt-24 border-y border-bg-border bg-bg-card/30"><div class="container-custom"><span class="label-gold">El programa</span><h2 class="text-3xl text-white sm:text-4xl lg:text-5xl">Un camino claro, de cero a tu agencia.</h2><p class="mt-4 text-text-muted">Primero preparas tu herramienta de trabajo. Después la aplicas a los procesos de la agencia.</p><div class="mt-9 grid gap-6 lg:grid-cols-2">{[{title:'Preparar ChatGPT',count:7,topics:courseOneTopics,icon:Laptop},{title:'Aplicar a tu agencia',count:10,topics:courseTwoTopics,icon:BriefcaseBusiness}].map((c,index)=><article class="premium-card overflow-hidden"><div class="relative h-40 overflow-hidden"><img src={index===0?'/images/hero.jpg':'/images/fernando-elegante.jpg'} alt="" width="800" height="400" loading="lazy" class="h-full w-full object-cover object-[center_30%] opacity-40" /><div class="absolute inset-0 bg-gradient-to-t from-bg-card to-transparent"></div><c.icon className="absolute bottom-5 left-6 h-12 w-12 text-gold-light" /></div><div class="p-6 pt-0 sm:p-8 sm:pt-0"><p class="text-xs uppercase tracking-widest text-gold-primary">Curso {index+1} · {c.count} sesiones</p><h3 class="mt-3 font-playfair text-3xl text-white">{c.title}</h3><ol class="mt-5 space-y-3">{c.topics.map((topic,n)=><li class="flex gap-3 text-sm text-text-muted"><span class="text-gold-primary">{String(n+1).padStart(2,'0')}</span>{topic}</li>)}</ol><a href="#formulario" class="btn-secondary mt-7 inline-block text-xs">Consultar este curso →</a></div></article>)}</div><p class="mt-6 rounded-xl border border-gold-primary/20 p-4 text-sm text-gold-light">Sesiones en directo todos los miércoles y viernes, con una duración de 2 horas por sesión (34 horas en total). Las fechas de cada edición y la disponibilidad se confirman por escrito. El Curso 2 requiere el Curso 1 o validación humana previa.</p></div></section>
    <section class="section" aria-labelledby="metodo-title"><div class="container-custom"><span class="label-gold">Cómo aprenderás</span><h2 id="metodo-title" class="text-3xl text-white sm:text-4xl lg:text-5xl">Fernando te guía desde su experiencia diaria en la agencia.</h2><div class="my-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">{[{title:'Revisamos dudas',text:'Ponemos en común las dificultades de la práctica anterior.'},{title:'Vemos y practicamos',text:'Trabajamos casos de agencia con datos ficticios.'},{title:'Te llevas materiales',text:'Guías, plantillas y recursos para repasar.'},{title:'Aplicas entre clases',text:'Avanzas con actividades y revisión de resultados.'}].map((i,n)=><div class="border-l border-gold-primary/40 pl-4"><span class="text-gold-primary">0{n+1}</span><h3 class="mt-3 font-semibold text-white">{i.title}</h3><p class="mt-2 text-sm text-text-muted">{i.text}</p></div>)}</div><div class="grid gap-6 lg:grid-cols-[1.5fr_1fr]"><div class="premium-card p-6"><div class="mb-4 flex justify-between gap-3"><span class="font-playfair text-xl text-white">Tu aula en Moodle</span><span class="text-xs text-gold-primary">Vista ilustrativa</span></div><div class="relative overflow-hidden rounded-xl"><img src="/images/hero.jpg" alt="Imagen ilustrativa del campus del curso" width="1920" height="1080" loading="lazy" class="h-56 w-full object-cover opacity-60" /><div class="absolute inset-0 flex flex-col items-center justify-center bg-black/20 text-center"><MonitorPlay className="mb-4 h-12 w-12 text-gold-light" /><p class="font-playfair text-2xl text-white">Tu sistema de trabajo en la agencia</p><p class="mt-2 text-sm text-white">Sesiones · Materiales · Actividades</p></div></div></div><div class="space-y-4">{[{icon:MonitorPlay,title:'Sesiones grabadas',text:'Repasa las explicaciones y demostraciones.'},{icon:GraduationCap,title:'Guías y plantillas',text:'Materiales de apoyo para aprender paso a paso.'},{icon:Sparkles,title:'Conceptos y recursos',text:'Entiende el sistema y practica entre sesiones.'}].map(i=><div class="premium-card flex gap-4 p-5"><i.icon className="h-7 w-7 shrink-0 text-gold-primary" /><div><h3 class="font-semibold text-white">{i.title}</h3><p class="mt-1 text-sm text-text-muted">{i.text}</p></div></div>)}</div></div></div></section>
    <section id="precios" class="section scroll-mt-24 border-t border-bg-border bg-[#0D0D0D]" aria-labelledby="precios-title">
      <div class="container-custom">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <span class="label-gold">Precios y ediciones</span>
