---
import Layout from '../layouts/Layout.astro';
import DynamicBackground from '../components/ui/DynamicBackground.astro';
import { GraduationCap, Users, Clock, Video, Check, ArrowRight, MessageCircle } from 'lucide-react';
---

<Layout
  title="Formación en IA para Agencias de Viajes | 60€/hora | TravelAgentIA"
  description="Formación en IA para agencias de viajes: enseño a tu equipo a trabajar con las herramientas que ya tienen. Sesiones por videoconferencia a 60€/hora."
  ogImage="/images/og/og-formacion.png"
>
  <main class="pt-32 pb-20">
    <!-- HERO -->
    <section class="relative pt-32 pb-24 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <DynamicBackground variant="hero" />
      </div>
      <div class="container-custom relative z-10">
        <div class="max-w-3xl">
          <span class="label-gold">FORMACIÓN</span>
          <h1 class="text-5xl md:text-6xl mb-6 text-gradient font-playfair">
            Que tu equipo saque<br />provecho de lo que tiene.
          </h1>
          <p class="text-xl text-text-muted mb-4">
            Sesiones formativas por videoconferencia. Enseño a usar la IA con las herramientas que ya pagáis.
          </p>
          <div class="flex items-center gap-3 text-gold-primary text-lg font-jetbrains">
            <Clock class="w-5 h-5" />
            <span>60€ / hora</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CURSO CHATGPT WORK 2026 -->
    <section class="relative z-20 -mt-10 pb-10" aria-labelledby="curso-chatgpt-work-title">
      <div class="container-custom">
        <div class="overflow-hidden rounded-2xl border border-gold-primary/40 bg-bg-card shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
          <div class="grid grid-cols-1 items-center gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:p-10">
            <div>
              <span class="label-gold">NUEVO · OCT–NOV 2026</span>
              <h2 id="curso-chatgpt-work-title" class="text-3xl text-white sm:text-4xl">
                Curso ChatGPT Work para agencias de viajes
              </h2>
              <p class="mt-4 max-w-3xl text-text-muted sm:text-lg">
                17 sesiones prácticas, dos cursos, casos 100 % sintéticos y acompañamiento de implantación. Del 5 de octubre al 16 de noviembre, lunes, miércoles y viernes de 17:00 a 19:00.
              </p>
              <p class="mt-3 text-xs text-amber-100/75">
                Fechas, plazas y precios provisionales, sujetos a confirmación antes de cualquier inscripción.
              </p>
              <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm text-gold-light">
                <span class="flex items-center gap-2"><Users className="h-4 w-4" aria-hidden="true" /> 10–12 plazas</span>
                <span class="flex items-center gap-2"><Clock className="h-4 w-4" aria-hidden="true" /> Desde 150 € + IVA</span>
                <span class="flex items-center gap-2"><GraduationCap className="h-4 w-4" aria-hidden="true" /> Con Fernando Córdoba</span>
              </div>
            </div>
            <a
              href="/curso-chatgpt-work-agencias-viajes"
              class="btn-primary inline-flex min-h-12 items-center justify-center gap-2 whitespace-nowrap text-center focus:outline-none focus:ring-2 focus:ring-gold-light focus:ring-offset-2 focus:ring-offset-bg-dark"
            >
              VER EL PROGRAMA <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- QUÉ ES -->
    <section class="py-20">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
          <div>
            <h2 class="text-3xl font-playfair text-white mb-6">¿Qué es la formación?</h2>
            <p class="text-text-muted text-lg mb-6 leading-relaxed">
              Enseño a tu equipo a trabajar con IA de forma práctica y aplicada a su día a día. 
              <strong class="text-white">Sesiones adaptadas a su puesto</strong>: comerciales, operaciones, marketing, dirección.
            </p>
            <p class="text-text-muted text-lg mb-6 leading-relaxed">
              Nada de teoría genérica. Partimos de cómo trabaja cada persona y construimos desde ahí. 
              Un agente senior no aprende igual que alguien que empieza.
            </p>
            <p class="text-text-muted text-lg mb-8 leading-relaxed">
              <em class="text-text-muted/60">Nota: si buscas un proceso de implantación completo con guiño personal y 
              seguimiento, mira <a href="/consultoria" class="text-gold-primary underline">Consultoría</a> — 
              la formación a tus empleados es parte de ese servicio.</em>
            </p>

            <a href="/reservar" class="btn-primary inline-flex items-center gap-2">
              SOLICITAR FORMACIÓN <ArrowRight class="w-4 h-4" />
            </a>
          </div>

          <div class="space-y-6">
            <h3 class="text-sm font-jetbrains text-gold-primary uppercase tracking-widest">Qué puedes esperar</h3>
            {[
              { icon: Users, title: 'Para uno o para todos', desc: 'Sesión individual o grupal. Me adapto al tamaño de tu equipo.' },
              { icon: Video, title: 'Por videoconferencia', desc: 'Grabación disponible bajo petición. Asistes desde donde quieras.' },
              { icon: GraduationCap, title: 'A tu ritmo', desc: 'Contenido adaptado al nivel de cada participante.' },
              { icon: MessageCircle, title: 'Dudas en tiempo real', desc: 'Sesión interactiva, no monólogo. Pregunta lo que quieras.' },
            ].map(item => (
              <div class="premium-card flex gap-4 items-start">
                <item.icon class="w-6 h-6 text-gold-primary shrink-0 mt-1" />
                <div>
                  <h4 class="text-white font-playfair mb-1">{item.title}</h4>
                  <p class="text-sm text-text-muted">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- TIPOS DE FORMACIÓN -->
    <section class="py-20 border-t border-bg-border">
      <div class="container-custom">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-playfair text-white mb-4">¿Qué tipo de formación necesitas?</h2>
          <p class="text-text-muted">Tres modalidades según el nivel de tu equipo</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            {
              title: 'Onboarding IA',
              desc: 'Primeros pasos para no perderse.',
              detail: '2-4 horas',
              items: [
                'Qué es y qué no es un LLM',
                'Cómo hablar con la IA (prompting básico)',
                'Primeros casos de uso reales en la agencia',
                'Errores comunes y cómo evitarlos',
              ]
            },
            {
              title: 'Formación a medida',
              desc: 'Contenido según el puesto y necesidades.',
              detail: 'A definir',
              items: [
                'Para comerciales: propuestas y seguimiento',
                'Para operaciones: gestión y expedientes',
                'Para marketing: contenido y calendario',
                'Lo que tu equipo necesite',
              ]
            },
            {
              title: 'Coaching avanzado',
              desc: 'Para equipos que ya usan IA pero quieren más.',
              detail: 'A definir',
              items: [
                'Sistematización de flujos',
                'Prompting avanzado y chaining',
                'Integración con herramientas del sector',
                'Automatización de tareas recurrentes',
              ]
            },
          ].map(t => (
            <div class="premium-card flex flex-col">
              <h3 class="text-xl text-white font-playfair mb-2">{t.title}</h3>
              <p class="text-sm text-text-muted mb-4">{t.desc}</p>
              <span class="text-xs font-jetbrains text-gold-primary uppercase tracking-widest mb-6">{t.detail}</span>
              <ul class="space-y-3 flex-grow">
                {t.items.map(item => (
                  <li class="flex items-start gap-2 text-sm text-text-muted">
                    <Check class="w-4 h-4 text-gold-primary shrink-0 mt-0.5" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- DIFERENCIA CON CONSULTORÍA -->
    <section class="py-20 border-t border-bg-border">
      <div class="container-custom">
        <div class="premium-card p-8 md:p-12">
          <h2 class="text-2xl font-playfair text-white mb-6">⚠️ ¿Formación o Consultoría?</h2>
          <p class="text-text-muted mb-6 leading-relaxed">
            <strong class="text-white">Formación = te enseño a usar la IA.</strong> 
            Ideal cuando quieres que tu equipo gane autonomía con las herramientas que ya tiene.
          </p>
          <p class="text-text-muted leading-relaxed">
            Si buscas un proceso más profundo — que alguien te guíe personalmente para implantar IA de 
            forma integral en tu oficina y formar a tus empleados como parte del proceso — 
            mira <a href="/consultoria" class="text-gold-primary underline">Consultoría</a>: 
            trabajo personal a 150€/hora donde la formación a tu equipo es parte del servicio.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-20 border-t border-bg-border">
      <div class="container-custom text-center">
        <h2 class="text-3xl font-playfair text-white mb-6">¿Quieres analizar las necesidades de tu equipo?</h2>
        <p class="text-text-muted mb-10 max-w-xl mx-auto">
          Sesión de diagnóstico gratuita. Sin compromiso. Vemos el nivel actual, identificamos gaps y te propongo un plan de formación.
        </p>
        <a href="/reservar" class="btn-primary px-12 py-4 text-lg">RESERVAR DIAGNÓSTICO GRATUITO</a>
      </div>
    </section>
  </main>
</Layout>
