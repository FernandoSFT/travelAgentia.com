---
import Layout from '../layouts/Layout.astro';
import { getSecciones } from '../lib/notion';

const secciones = await getSecciones();
const data = secciones.find(s => s.Slug === "gracias" || (s.Página === "Global" && s.Slug === "gracias"));
---

<Layout title="Gracias">
	<main class="min-h-screen flex items-center justify-center relative bg-background">
		<div class="absolute inset-0 bg-[url('/noise.png')] opacity-5 pointer-events-none"></div>
		
		<div class="container mx-auto px-4 relative z-10 text-center max-w-2xl">
			<h1 class="text-4xl md:text-5xl mb-6 text-gradient">
				{data ? data.Título : "¡Solicitud recibida!"}
			</h1>
			<p class="text-gray-300 text-lg mb-8">
				{data ? data.Cuerpo : "Gracias por contactar. Me pondré en contacto contigo muy pronto."}
			</p>
			
			<a href="/" class="inline-block border border-primary text-primary font-inter font-bold uppercase tracking-widest px-8 py-4 rounded hover:bg-primary hover:text-background hover:-translate-y-1 transition-all">
				{data ? data["CTA texto"] || "VOLVER AL INICIO" : "VOLVER AL INICIO"}
			</a>
		</div>
	</main>
</Layout>
