---
import Layout from '../layouts/Layout.astro';
import { getSecciones } from '../lib/notion';
import { marked } from 'marked';

const secciones = await getSecciones();
const data = secciones.find(s => s.Slug === "legal-privacidad" || s.Página === "Legal");
---

<Layout title={data?.Título || "Política de Privacidad"}>
	<main class="min-h-screen pt-32 pb-20 bg-background relative">
		<div class="absolute inset-0 bg-[url('/noise.png')] opacity-5 pointer-events-none"></div>
		
		<div class="container mx-auto px-4 relative z-10 max-w-3xl">
			<h1 class="text-4xl md:text-5xl mb-12 text-gradient font-playfair">{data?.Título || "Política de Privacidad"}</h1>
			{data?.Cuerpo && (
				<div class="prose prose-invert prose-p:text-gray-300 prose-headings:text-primary max-w-none prose-a:text-primaryHover" set:html={marked.parse(data.Cuerpo)} />
			)}
		</div>
	</main>
</Layout>
