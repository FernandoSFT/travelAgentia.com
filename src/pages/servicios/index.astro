---
import Layout from '../../layouts/Layout.astro';
import DynamicBackground from '../../components/ui/DynamicBackground.astro';
import { Users, Headphones, Key, Check, Zap, Layers, BarChart3, Bot, ArrowRight } from 'lucide-react';
---

<Layout title="Servicios de IA para Agencias de Viajes | TravelAgentIA" ogImage="/images/og/og-servicios.png">
  <main class="pt-32 pb-20">
    <section class="relative pt-32 pb-20 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <DynamicBackground variant="hero" />
      </div>
      <div class="container-custom relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-soft-reveal">
          <span class="label-gold">CATÁLOGO DE SERVICIOS</span>
          <h1 class="text-5xl md:text-6xl mb-6 text-gradient font-playfair">IA para agencias de viajes</h1>
          <p class="text-lg text-text-muted">
            Tres niveles de acompañamiento. Desde aprender a tu ritmo hasta delegar por completo. Elige el que mejor se adapte a dónde está tu agencia hoy.
          </p>
        </div>
      </div>

      <!-- TRES PILARES -->
      <div class="container-custom">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
          <!-- Formación -->
          <a href="/formacion" class="premium-card group hover:border-gold-primary/40 transition-all flex flex-col">
            <div class="w-14 h-14 rounded-2xl bg-gold-primary/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <Users class="w-7 h-7 text-gold-primary" />
            </div>
            <h2 class="text-xl text-white font-playfair mb-3">Formación</h2>
            <p class="text-sm text-text-muted mb-6 flex-grow">Te enseño a tu equipo a trabajar con IA. Sesiones adaptadas a cada puesto.</p>
            <div class="flex items-center justify-between pt-6 border-t border-white/5">
              <span class="text-xs font-jetbrains text-gold-primary">60€/hora</span>
              <span class="text-xs text-text-muted flex items-center gap-1 group-hover:text-gold-primary transition-colors">
                Saber más <ArrowRight class="w-3 h-3" />
              </span>
            </div>
          </a>

          <!-- Consultoría -->
          <a href="/consultoria" class="premium-card group hover:border-gold-primary/40 transition-all flex flex-col">
            <div class="w-14 h-14 rounded-2xl bg-gold-primary/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <Headphones class="w-7 h-7 text-gold-primary" />
            </div>
            <h2 class="text-xl text-white font-playfair mb-3">Consultoría</h2>
            <p class="text-sm text-text-muted mb-6 flex-grow">Yo hago el trabajo por ti. Videoconferencia, entrega directa de solución.</p>
            <div class="flex items-center justify-between pt-6 border-t border-white/5">
              <span class="text-xs font-jetbrains text-gold-primary">150€/hora</span>
              <span class="text-xs text-text-muted flex items-center gap-1 group-hover:text-gold-primary transition-colors">
                Saber más <ArrowRight class="w-3 h-3" />
              </span>
            </div>
          </a>

          <!-- Lo Hacemos Por Ti -->
          <a href="/reservar" class="premium-card group hover:border-gold-primary/40 transition-all flex flex-col">
            <div class="w-14 h-14 rounded-2xl bg-gold-primary/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <Key class="w-7 h-7 text-gold-primary" />
            </div>
            <h2 class="text-xl text-white font-playfair mb-3">Lo Hacemos Por Ti</h2>
            <p class="text-sm text-text-muted mb-6 flex-grow">Delegación total. Construyo tu ecosistema de IA completo y te lo entrego funcionando.</p>
            <div class="flex items-center justify-between pt-6 border-t border-white/5">
              <span class="text-xs font-jetbrains text-gold-primary">Consultar</span>
              <span class="text-xs text-text-muted flex items-center gap-1 group-hover:text-gold-primary transition-colors">
                Solicitar presupuesto <ArrowRight class="w-3 h-3" />
              </span>
            </div>
          </a>
        </div>
      </div>

      <!-- SECCIONES DETALLADAS -->
      <div class="space-y-32">
        <!-- 1. Comunidad -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <Users class="w-16 h-16 text-gold-primary mb-8" />
            <h2 class="text-4xl mb-6 text-white font-playfair">La Comunidad TravelAgentIA</h2>
            <p class="text-lg text-text-muted mb-8">El punto de entrada ideal para agentes que quieren aprender a su ritmo pero no quieren estar solos. Un ecosistema vivo de profesionales compartiendo lo que funciona.</p>
            <ul class="space-y-4 mb-10">
              {[
                'Sesiones grupales semanales de actualización.',
                'Biblioteca de "BecarIAs" (prompts y flujos listos para usar).',
                'Foro privado de dudas y soporte entre colegas.',
                'Actualización constante sobre herramientas del sector.'
              ].map(item => (
                <li class="flex items-start gap-3 text-text-main">
                  <Check class="w-5 h-5 text-gold-primary shrink-0 mt-1" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a href="https://www.skool.com/automatiza2-1075/about" target="_blank" rel="noopener noreferrer" class="btn-secondary py-3 px-8">MÁS INFORMACIÓN</a>
          </div>
          <div class="premium-card bg-bg-dark border-gold-primary/20">
            <div class="aspect-video bg-bg-card rounded-lg overflow-hidden flex items-center justify-center border border-bg-border">
              <span class="text-gold-primary text-sm font-jetbrains uppercase tracking-widest">Vista previa de la comunidad</span>
            </div>
          </div>
        </section>

        <!-- 2. Formación -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center lg:flex-row-reverse">
          <div class="lg:order-2">
            <Users class="w-16 h-16 text-gold-primary mb-8" />
            <h2 class="text-4xl mb-6 text-white font-playfair">Formación Personalizada</h2>
            <p class="text-lg text-text-muted mb-8">Te enseño a tu equipo a trabajar con IA de forma práctica y aplicada a su puesto. Un agente, un equipo, toda la plantilla.</p>
            <ul class="space-y-4 mb-10">
              {[
                'Sesiones individuales o grupales por videoconferencia.',
                'Contenido adaptado al nivel y puesto de cada participant.',
                'Onboarding IA, formación a medida o coaching avanzado.',
                'Grabación disponible bajo petición.'
              ].map(item => (
                <li class="flex items-start gap-3 text-text-main">
                  <Check class="w-5 h-5 text-gold-primary shrink-0 mt-1" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a href="/formacion" class="btn-primary py-3 px-8">VER DETALLES</a>
          </div>
          <div class="lg:order-1 premium-card bg-bg-dark border-gold-primary/20">
            <div class="grid grid-cols-2 gap-4">
              {[
                { icon: Users, label: 'Individual o grupal' },
                { icon: Zap, label: 'A tu ritmo' },
              ].map(item => (
                <div class="bg-bg-card p-6 rounded-lg border border-bg-border flex flex-col items-center justify-center gap-3 text-center min-h-[100px]">
                  <item.icon class="w-8 h-8 text-gold-primary" />
                  <span class="text-xs text-text-muted">{item.label}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- 3. Consultoría -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <Headphones class="w-16 h-16 text-gold-primary mb-8" />
            <h2 class="text-4xl mb-6 text-white font-playfair">Consultoría 1 a 1</h2>
            <p class="text-lg text-text-muted mb-8">Me cuentas tu problema, yo lo resuelvo. Sin teoría, sin cursos, sin rodeos. Videoconferencia y te entrego la solución funcionando.</p>
            <ul class="space-y-4 mb-10">
              {[
                'Búsquedas complejas y hoteles imposibles.',
                'Automatizaciones y flujos de trabajo.',
                'Respuestas difíciles, emails, reclamaciones.',
                'Análisis de mercado y benchmarking.'
              ].map(item => (
                <li class="flex items-start gap-3 text-text-main">
                  <Check class="w-5 h-5 text-gold-primary shrink-0 mt-1" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a href="/consultoria" class="btn-secondary py-3 px-8">VER DETALLES</a>
          </div>
          <div class="premium-card bg-bg-dark border-gold-primary/20">
             <div class="grid grid-cols-2 gap-4">
                {[Zap, Layers, BarChart3, Bot].map(Icon => (
                  <div class="bg-bg-card p-6 rounded-lg border border-bg-border flex items-center justify-center">
                    <Icon class="w-8 h-8 text-gold-primary" />
                  </div>
                ))}
             </div>
          </div>
        </section>

        <!-- 4. Lo Hacemos Por Ti -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center lg:flex-row-reverse">
          <div class="lg:order-2">
            <Key class="w-16 h-16 text-gold-primary mb-8" />
            <h2 class="text-4xl mb-6 text-white font-playfair">Lo Hacemos Por Ti</h2>
            <p class="text-lg text-text-muted mb-8">Delegación total. Construimos tu ecosistema de IA completo, lo probamos y te lo entregamos listo para facturar más con menos esfuerzo.</p>
            <ul class="space-y-4 mb-10">
              {[
                'Implementación de más de 20 agentes IA coordinados.',
                'Integración total entre Notion, n8n y tu CRM/Email.',
                'Automatización de propuestas comerciales premium.',
                'Soporte prioritario post-implementación.'
              ].map(item => (
                <li class="flex items-start gap-3 text-text-main">
                  <Check class="w-5 h-5 text-gold-primary shrink-0 mt-1" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a href="/reservar" class="btn-primary py-3 px-8">SOLICITAR PRESUPUESTO</a>
          </div>
          <div class="lg:order-1 premium-card bg-bg-dark border-gold-primary/50 shadow-[0_0_50px_rgba(201,168,76,0.1)]">
            <div class="aspect-video bg-bg-card rounded-lg overflow-hidden flex items-center justify-center border border-bg-border">
              <span class="text-gold-primary text-sm font-jetbrains uppercase tracking-widest">Ecosistema completo</span>
            </div>
          </div>
        </section>
      </div>

      <!-- CTA FINAL -->
      <section class="mt-32 pt-20 border-t border-bg-border text-center">
        <h2 class="text-3xl font-playfair mb-8 text-white">¿No sabes por dónde empezar?</h2>
        <p class="text-text-muted mb-10">La mayoría de agencias empiezan por una sesión de diagnóstico gratuita para ver qué camino es el más rentable para ellas.</p>
        <a href="/reservar" class="btn-primary px-12 py-4">RESERVAR MI SESIÓN AHORA</a>
      </section>
    </section>
  </main>
</Layout>
