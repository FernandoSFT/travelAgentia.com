---
---
<nav id="navbar" class="fixed top-0 w-full z-50 transition-all duration-300 py-6">
  <div class="container-custom flex items-center justify-between">
    <a href="/" class="group">
      <span class="text-2xl font-playfair font-bold text-gradient group-hover:opacity-80 transition-opacity">
        TravelAgentIA
      </span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#sobre-mi" class="text-sm font-medium text-text-muted hover:text-gold-light transition-colors">Sobre mí</a>
      <a href="#metodologia" class="text-sm font-medium text-text-muted hover:text-gold-light transition-colors">Metodología</a>
      <a href="#servicios" class="text-sm font-medium text-text-muted hover:text-gold-light transition-colors">Servicios</a>
      <a href="#casos" class="text-sm font-medium text-text-muted hover:text-gold-light transition-colors">Casos reales</a>
      <a href="#faq" class="text-sm font-medium text-text-muted hover:text-gold-light transition-colors">FAQ</a>
      <a href="#contacto" class="btn-primary py-2 px-6 text-xs">Contacto</a>
    </div>

    <!-- Mobile Toggle -->
    <button id="mobile-toggle" class="md:hidden text-gold-primary" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="close-icon hidden"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
    </button>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-bg-dark border-b border-bg-border p-6 flex flex-col gap-6 animate-fade-in">
    <a href="#sobre-mi" class="text-lg font-medium text-text-main">Sobre mí</a>
    <a href="#metodologia" class="text-lg font-medium text-text-main">Metodología</a>
    <a href="#servicios" class="text-lg font-medium text-text-main">Servicios</a>
    <a href="#casos" class="text-lg font-medium text-text-main">Casos reales</a>
    <a href="#faq" class="text-lg font-medium text-text-main">FAQ</a>
    <a href="#contacto" class="btn-primary text-center">Contacto</a>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = toggle?.querySelector('.menu-icon');
  const closeIcon = toggle?.querySelector('.close-icon');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('bg-bg-dark/80', 'backdrop-blur-md', 'py-4', 'border-b', 'border-bg-border');
      navbar?.classList.remove('py-6');
    } else {
      navbar?.classList.remove('bg-bg-dark/80', 'backdrop-blur-md', 'py-4', 'border-b', 'border-bg-border');
      navbar?.classList.add('py-6');
    }
  });

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>

<style>
  #mobile-menu.animate-fade-in {
    animation: fadeIn 0.3s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
