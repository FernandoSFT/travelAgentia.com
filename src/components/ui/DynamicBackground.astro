---
/**
 * DynamicBackground — Fondo de imagen aleatoria de Unsplash
 * Pool curado: IA + Agencia de Viajes
 * Uso: <DynamicBackground variant="hero" /> dentro de un div relative
 */
interface Props {
  /** 'hero' | 'section' | 'subtle' — controla opacidad del overlay */
  variant?: 'hero' | 'section' | 'subtle';
  /** Clases CSS extra para el wrapper */
  class?: string;
  /** Forzar una imagen específica (por ID de Unsplash, ej: 'photo-xxx'). Vacío = aleatorio. */
  forced?: string;
}

const { variant = 'hero', class: extraClass = '', forced = '' } = Astro.props;

// Pool de imágenes curadas — IA + Agencia de Viajes
const POOL = [
  'https://images.unsplash.com/photo-1677442135703-1787eea5ce01?w=1920&q=80',   // Redes neuronales
  'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1920&q=80',   // Dashboard analytics
  'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=1920&q=80',   // Robot / IA
  'https://images.unsplash.com/photo-1518432031352-d6fc5c10da5a?w=1920&q=80',   // Circuitos / automatización
  'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=80',   // Red global
  'https://images.unsplash.com/photo-1497366216548-37526070297c?w=1920&q=80',   // Workspace moderno
  'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1920&q=80',   // Métricas / growth
  'https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?w=1920&q=80',   // Data science
];

// Overlay opacity según variant
const overlayOpacity: Record<string, string> = {
  hero:    'bg-gradient-to-b from-bg-dark/60 via-bg-dark/30 to-bg-dark',
  section: 'bg-gradient-to-b from-bg-card/40 via-bg-card/20 to-bg-card/10',
  subtle:  'bg-gradient-to-b from-bg-dark/20 via-bg-dark/10 to-bg-dark',
};
---

<div
  class={`absolute inset-0 overflow-hidden ${extraClass}`}
  data-dynamic-bg
  data-pool={JSON.stringify(POOL)}
  data-variant={variant}
>
  {forced ? (
    <img
      src={forced}
      alt="Background"
      class="w-full h-full object-cover opacity-30 animate-ken-burns"
      loading="eager"
    />
  ) : (
    <img
      src={POOL[0]}
      alt="Background"
      class="w-full h-full object-cover opacity-30 animate-ken-burns"
      loading="eager"
      data-bg-src
    />
  )}

  <!-- Overlay gradiente -->
  <div class={`absolute inset-0 ${overlayOpacity[variant]}`}></div>

  <!-- Noise texture -->
  <div class="absolute inset-0 bg-[url('/noise.png')] opacity-5 pointer-events-none"></div>
</div>

{!forced && (
  <script is:inline define:vars={{ POOL, variant }}>
    document.querySelectorAll('[data-dynamic-bg]').forEach(function (container) {
      var src = POOL[Math.floor(Math.random() * POOL.length)];
      var img = container.querySelector('[data-bg-src]');
      if (img) img.src = src;
    });
  </script>
)}
