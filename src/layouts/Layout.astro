---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Inteligencia Artificial que funciona porque la usamos cada día. De agente a agente." } = Astro.props;

// JSON-LD schemas
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Fernando Córdoba",
	"jobTitle": "Consultor de IA para agencias de viajes",
	"url": Astro.site?.toString() || "https://travelagentia.com",
};

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"name": "TravelAgentIA",
	"areaServed": "ES",
	"priceRange": "€€",
	"url": Astro.site?.toString() || "https://travelagentia.com",
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | TravelAgentIA</title>
		
		<!-- Open Graph / Twitter -->
		<meta property="og:title" content={`${title} | TravelAgentIA`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | TravelAgentIA`} />
		<meta name="twitter:description" content={description} />
		
		<!-- JSON-LD -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
		
		{import.meta.env.PUBLIC_GSC_VERIFICATION && (
			<meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
		)}

		{import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
			<script is:inline defer data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.tagged-events.outbound-links.js"></script>
		)}
		
		<slot name="head" />
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />

		<CookieBanner client:load />

		<script>
			import { track } from '../lib/analytics';

			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				const link = target.closest('a');
				if (!link) return;

				const href = link.getAttribute('href') || '';
				const className = link.className || '';

				// Download Media Kit
				if (className.includes('plausible-event-name=Download+Media+Kit')) {
					track('Download Media Kit');
				}

				// Reserva Cita Click
				if (href.includes('/reserva-cita') || href.includes('calendar.app.google')) {
					track('Reserva Cita Click');
				}

				// WhatsApp Click
				if (href.startsWith('wa.me') || href.startsWith('whatsapp://') || href.startsWith('https://wa.me')) {
					track('WhatsApp Click');
				}

				// Email Click
				if (href.startsWith('mailto:')) {
					track('Email Click');
				}
			});
		</script>
	</body>
</html>
