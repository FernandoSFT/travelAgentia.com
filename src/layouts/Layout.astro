---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	schemas?: object[];
}

const {
	title,
	description = "Inteligencia Artificial que funciona porque la usamos cada día. De agente a agente.",
	ogImage = "https://travelagentia.com/og-image.jpg",
	schemas = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const siteBase = Astro.site?.toString().replace(/\/$/, '') || "https://travelagentia.com";

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Fernando Córdoba",
	"jobTitle": "Consultor de IA para agencias de viajes",
	"url": siteBase,
	"sameAs": [
		"https://linkedin.com/in/fernandocordoba",
		"https://instagram.com/safetour.es",
		"https://www.skool.com/automatiza2-1075/about"
	],
	"knowsAbout": ["Inteligencia artificial", "Agencias de viajes", "Automatización", "Notion", "n8n"],
	"hasOccupation": {
		"@type": "Occupation",
		"name": "Consultor de IA para agencias de viajes",
		"occupationalCategory": "15-1299.09"
	},
	"brand": { "@type": "Brand", "name": "TravelAgentIA" }
};

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "TravelAgentIA",
	"url": siteBase,
	"logo": `${siteBase}/og-image.jpg`,
	"contactPoint": {
		"@type": "ContactPoint",
		"email": "automatiza2@automatiza2.com",
		"telephone": "+34717717266",
		"contactType": "customer service",
		"areaServed": "ES",
		"availableLanguage": "Spanish"
	},
	"sameAs": [
		"https://linkedin.com/in/fernandocordoba",
		"https://instagram.com/safetour.es"
	]
};

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"url": canonicalURL,
	"name": `${title} | TravelAgentIA`,
	"description": description,
	"speakable": {
		"@type": "SpeakableSpecification",
		"cssSelector": [".hero-description", ".service-summary", ".faq-answer"]
	}
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | TravelAgentIA</title>
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Twitter -->
		<meta property="og:title" content={`${title} | TravelAgentIA`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="TravelAgentIA" />
		<meta property="og:locale" content="es_ES" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | TravelAgentIA`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		
		<!-- JSON-LD -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
		{schemas.map(s => (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
		))}
		
		{import.meta.env.PUBLIC_GSC_VERIFICATION && (
			<meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
		)}

		{import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
			<script is:inline defer data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.tagged-events.outbound-links.js"></script>
		)}
		
		<slot name="head" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@500&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />

		<CookieBanner client:load />

		<script src="../scripts/scroll-reveal.ts"></script>

		<script>
			import { track } from '../lib/analytics';

			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				const link = target.closest('a');
				if (!link) return;

				const href = link.getAttribute('href') || '';
				const className = link.className || '';

				// Download Media Kit
				if (className.includes('plausible-event-name=Download+Media+Kit')) {
					track('Download Media Kit');
				}

				// Reserva Cita Click
				if (href.includes('/reserva-cita') || href.includes('calendar.app.google')) {
					track('Reserva Cita Click');
				}

				// WhatsApp Click
				if (href.startsWith('wa.me') || href.startsWith('whatsapp://') || href.startsWith('https://wa.me')) {
					track('WhatsApp Click');
				}

				// Email Click
				if (href.startsWith('mailto:')) {
					track('Email Click');
				}
			});
		</script>
	</body>
</html>
